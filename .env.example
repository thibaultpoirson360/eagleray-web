# Copy to .env for local work (.env is gitignored). On Vercel, set these as
# Project Environment Variables instead. Never commit real values.
# Full checklist: docs/tina-setup.md

# --- Local mode ------------------------------------------------------------
# true  = Tina's local database + no login (filesystem content, no GitHub,
#         no Redis, no Google). NEVER set to true on Vercel.
TINA_PUBLIC_IS_LOCAL=true

# --- Git provider (deployed only): the backend commits edits with this ------
# Fine-grained PAT, this repo only, "Contents: Read and write".
# Use a dedicated machine/bot account, not a person's account.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PERSONAL_ACCESS_TOKEN=
# Leave unset on Vercel: production resolves to main, a preview to its own
# branch (VERCEL_GIT_COMMIT_REF). Set only to force one branch everywhere.
# GITHUB_BRANCH=main

# --- Database adapter (deployed only): Upstash Redis, REST credentials ------
# Provisioned through Vercel Marketplace > Upstash (or upstash.com directly).
# The variable names below are what Tina's upstash-redis-level adapter reads;
# if the integration injects UPSTASH_REDIS_REST_URL / _TOKEN instead, copy the
# values into these two names.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Auth.js + Google OAuth (deployed only) ---------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts session cookies. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical URL of THIS deployment INCLUDING the /api/tina/auth path, e.g.
#   https://eaglerayexpeditions.com/api/tina/auth
# Must match the authorized redirect URI host in Google Console
# (redirect URI = NEXTAUTH_URL + /callback/google).
NEXTAUTH_URL=

# --- Optional ---------------------------------------------------------------
# Verbose logging while debugging sign-in / indexing. Leave off normally.
# TINA_AUTH_DEBUG=true
# TINA_DEBUG=true
# Only if the admin is served from a different origin than the site:
# PUBLIC_TINA_ADMIN_ORIGIN=
