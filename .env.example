# Copy to .env.local for local development. Never commit .env.local.

# Airtable — Personal Access Token (starts with "pat...").
# Create at https://airtable.com/create/tokens with scopes:
#   data.records:read   (required)
#   schema.bases:read   (optional, makes `npm run airtable:inspect` richer)
# and access granted to the Eagle Ray base only.
AIRTABLE_API_KEY=

# Airtable base id (starts with "app..."). Visible in the base URL:
# https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=

# Absolute origin of the deployment. Required in production so Open Graph
# image URLs are absolute — WhatsApp will not render a relative one.
NEXT_PUBLIC_SITE_URL=https://eaglerayexpeditions.com

# Optional. Defaults to 525568090942 (Thibault's direct line).
NEXT_PUBLIC_WHATSAPP_NUMBER=525568090942

# Local development only — points the Airtable SDK at scripts/mock-airtable.mjs.
# Leave unset everywhere else.
# AIRTABLE_ENDPOINT_URL=http://127.0.0.1:4400
