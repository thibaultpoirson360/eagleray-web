{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "routeFocus": {
      "type": "string",
      "enum": [
        "wildlife",
        "kite-wingfoil",
        "reef-paddle"
      ]
    },
    "claim": {
      "type": "string"
    },
    "tripDuration": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "tripSlug": {
      "type": "string"
    },
    "itineraryDays": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dayNumber": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      }
    },
    "testimonial": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string"
        },
        "citeName": {
          "type": "string"
        }
      }
    },
    "order": {
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug"
  ]
}