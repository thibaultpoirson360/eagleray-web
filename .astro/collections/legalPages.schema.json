{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "lede": {
      "type": "string"
    },
    "draftNote": {
      "type": "string"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "photoCredits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "creator": {
            "type": [
              "string",
              "null"
            ]
          },
          "creatorUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "licenseUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "originalUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}