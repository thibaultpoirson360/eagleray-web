---
/**
 * A private trip proposal (the `tripProposal` collection), reached only by a
 * long link. Sections, in order: opening photo, personal welcome, a day on
 * board, the route with its map, the boat options with prices, what is
 * included, and one closing call to reserve. Every "Reserve" button leads to
 * the same booking page (reserve.button.href); the client picks the boat there.
 *
 * Everything works without JavaScript: the boat choice is a set of radio
 * buttons styled with CSS, and the map is drawn at build time
 * (src/lib/proposal-map.ts). The map outlines are the shared ones in
 * src/lib/espiritu-santo-map.ts (© OpenStreetMap contributors).
 */
import { tinaField } from "@tinacms/astro/tina-field";
import PageHero from "./ui/PageHero.astro";
import Button from "./ui/Button.astro";
import { LAND } from "../lib/espiritu-santo-map";
import { ROUTE_D, placeStops } from "../lib/proposal-map";
import ImageSlider from "./ImageSlider.tsx";
import ProposalDay from "./ProposalDay.tsx";
import ProposalPhotos from "./ProposalPhotos.astro";
import CrewSummaryCard from "./CrewSummaryCard.astro";
import SliderDots from "./SliderDots.tsx";
import { loadBoats, loadBoatsSection, loadCrew, loadCrewSection } from "../lib/content";

interface Props {
  proposal: any;
  locale: string;
}

const { proposal, locale } = Astro.props as { proposal: any; locale: any };
const { hero, welcome, day, route, boat, offer, reserve, crew, notice, about, itinerary, practical, faq, legal } = proposal;
// Photos of a boat come from the Boats page, so they are edited once; the labels of the photo slider come from its pop-up texts.
const [boatsResult, boatsSection, crewResult, crewSection] = await Promise.all([loadBoats(locale), loadBoatsSection(locale), loadCrew(locale), loadCrewSection(locale)]);
const modal = boatsSection.data.boatsSection.modal;
const photosOf = (o: any) => {
  const own = ((o.photos ?? []) as any[]).filter((p) => p?.image).map((p) => ({ src: p.image as string, alt: (p.label as string) || o.name }));
  if (own.length > 0) return own;
  const found = boatsResult.boats.find((b: any) => b._sys.filename === o.boatSlug);
  return ((found?.photos ?? []) as any[]).filter((p) => p?.image).map((p) => ({ src: p.image as string, alt: (p.alt as string) || o.name }));
};
const crewMembers = ((crew?.members ?? []) as (string | null)[]).flatMap((name) => crewResult.members.filter((m: any) => m._sys.filename === String(name ?? "").trim()));
const reserveHref: string = reserve?.button?.href ?? "";
const reserveLabel: string = reserve?.button?.label ?? hero?.buttonLabel ?? "";
const scenes = ((day?.scenes ?? []) as any[]).filter(Boolean);
const options = ((boat?.options ?? []) as any[]).filter(Boolean);
const stopsIn = ((route?.stops ?? []) as any[]).filter((s) => s && typeof s.lat === "number" && typeof s.lon === "number");
const { stops, drawn } = placeStops(stopsIn);
const paragraphs = (text?: string | null) => (text ?? "").split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
// One literal class per option (Tailwind only keeps classes it can read here): show the panel whose radio is checked.
const showPanel = [
  "group-has-[#boat-0:checked]/boats:block",
  "group-has-[#boat-1:checked]/boats:block",
  "group-has-[#boat-2:checked]/boats:block",
  "group-has-[#boat-3:checked]/boats:block",
];
// Page gutter: clear of the depth gauge on the left from lg up (docs/design-system.md).
const gutter = "px-5 lg:pr-pad lg:pl-[calc(var(--spacing-pad)+var(--rail))]";
const eyebrow = "font-mono text-[.62rem] tracking-[.2em] text-ink/64 uppercase";
// A calm, generous page: smaller type than the rest of the site and a lot of air around every block.
const h2 = "text-[clamp(1.35rem,2.8vw,2.2rem)] leading-[1.2]";
const sectionBox = `relative mx-auto max-w-site ${gutter} py-[calc(var(--spacing-section)*2.8)]`;
---

<PageHero
  tone="quiet"
  title={hero.title}
  kicker={hero.kicker}
  lede={hero.lede}
  supporting={hero.dates}
  image={hero.image}
  imageAlt={hero.imageAlt}
  cta={reserveHref && hero.buttonLabel ? { label: hero.buttonLabel, href: reserveHref } : null}
  fields={{
    title: tinaField(hero, "title"),
    kicker: tinaField(hero, "kicker"),
    lede: tinaField(hero, "lede"),
    supporting: tinaField(hero, "dates"),
    image: tinaField(hero, "image"),
    cta: tinaField(hero, "buttonLabel"),
  }}
/>

{
  (notice?.availability || notice?.expires) && (
    <div class="bg-ink text-white">
      <div class={`mx-auto flex max-w-site flex-wrap items-center justify-center gap-x-12 gap-y-3 ${gutter} py-6 font-mono text-[.62rem] tracking-[.2em] text-white/86 uppercase`}>
        {notice.availability && <p data-tina-field={tinaField(notice, "availability")}>{notice.availability}</p>}
        {notice.availability && notice.expires && <span class="hidden h-3 w-px bg-white/30 md:block" aria-hidden="true"></span>}
        {notice.expires && <p data-tina-field={tinaField(notice, "expires")}>{notice.expires}</p>}
      </div>
    </div>
  )
}

{
  welcome && (
    <section class="bg-surface">
      <div class:list={[sectionBox, "grid gap-16 md:grid-cols-[1fr_1.4fr] md:gap-32"]}>
        <div>
          {welcome.eyebrow && <p class={eyebrow} data-tina-field={tinaField(welcome, "eyebrow")}>{welcome.eyebrow}</p>}
          <h2 class={`mt-7 ${h2}`} data-tina-field={tinaField(welcome, "title")}>{welcome.title}</h2>
        </div>
        <div class="space-y-9 font-serif text-[clamp(1rem,1.7vw,1.2rem)] leading-[1.8] text-ink/86" data-tina-field={tinaField(welcome, "text")}>
          {paragraphs(welcome.text).map((p) => <p>{p}</p>)}
          {welcome.signature && <p class="pt-6 font-sans text-[.75rem] tracking-wide text-ink/64" data-tina-field={tinaField(welcome, "signature")}>{welcome.signature}</p>}
        </div>
      </div>
      {(welcome.photos?.length ?? 0) > 0 && (
        <div class={`mx-auto max-w-site ${gutter} pb-[calc(var(--spacing-section)*2.8)]`}>
          <ProposalPhotos photos={welcome.photos} />
        </div>
      )}
    </section>
  )
}

{
  about && (
    <section class="bg-white">
      <div class:list={[sectionBox, "grid gap-16 md:grid-cols-[1fr_1.4fr] md:gap-32"]}>
        <div>
          {about.eyebrow && <p class={eyebrow} data-tina-field={tinaField(about, "eyebrow")}>{about.eyebrow}</p>}
          <h2 class={`mt-7 ${h2}`} data-tina-field={tinaField(about, "title")}>{about.title}</h2>
          {about.quote && <p class="mt-12 max-w-[26ch] font-serif text-[clamp(1.05rem,1.8vw,1.3rem)] leading-[1.5] text-ink/86 italic" data-tina-field={tinaField(about, "quote")}>{about.quote}</p>}
        </div>
        <div class="space-y-8 text-[.82rem] leading-[1.9] text-ink/74" data-tina-field={tinaField(about, "text")}>
          {paragraphs(about.text).map((p) => <p>{p}</p>)}
        </div>
      </div>
      {about.image && (
        <div class={`mx-auto max-w-site ${gutter} pb-[calc(var(--spacing-section)*2.8)]`}>
          <img src={about.image} alt={about.imageAlt ?? ""} width="1250" height="470" loading="lazy" decoding="async" class="h-auto w-full rounded-lg" data-tina-field={tinaField(about, "image")} />
        </div>
      )}
    </section>
  )
}

{
  scenes.length > 0 && (
    <ProposalDay
      client:load
      eyebrow={day.eyebrow ?? ""}
      title={day.title ?? ""}
      note={day.note ?? ""}
      fields={{ eyebrow: tinaField(day, "eyebrow"), title: tinaField(day, "title"), note: tinaField(day, "note") }}
      scenes={scenes.filter((x) => x.image).map((x) => ({
        time: x.time ?? "",
        title: x.title ?? "",
        text: x.text ?? "",
        image: x.image,
        imageAlt: x.imageAlt ?? "",
        fields: { time: tinaField(x, "time"), title: tinaField(x, "title"), text: tinaField(x, "text"), image: tinaField(x, "image") },
      }))}
    />
  )
}

{
  itinerary && (itinerary.days?.length ?? 0) > 0 && (
    <section class="bg-surface">
      <div class={sectionBox}>
        {itinerary.eyebrow && <p class={eyebrow} data-tina-field={tinaField(itinerary, "eyebrow")}>{itinerary.eyebrow}</p>}
        <h2 class={`mt-7 ${h2}`} data-tina-field={tinaField(itinerary, "title")}>{itinerary.title}</h2>
        {itinerary.intro && <p class="mt-8 max-w-[56ch] text-[.85rem] leading-[1.8] text-ink/74" data-tina-field={tinaField(itinerary, "intro")}>{itinerary.intro}</p>}
        <div class="mt-24 border-t border-ink/14">
          {itinerary.days.map((d: any) => (
            <div class="grid gap-8 border-b border-ink/14 py-16 md:grid-cols-[14rem_1fr] md:gap-24" data-tina-field={tinaField(d)}>
              <div>
                <p class={eyebrow} data-tina-field={tinaField(d, "label")}>{d.label}</p>
                <h3 class="mt-4 font-display text-[1.3rem] leading-tight" data-tina-field={tinaField(d, "title")}>{d.title}</h3>
              </div>
              <div>
              <ul class="space-y-6">
                {((d.moments ?? []) as any[]).map((m) => (
                  <li class="grid gap-1 sm:grid-cols-[7.5rem_1fr] sm:gap-6" data-tina-field={tinaField(m)}>
                    <span class={`${eyebrow} pt-1`}>{m.time}</span>
                    <span class="text-[.82rem] leading-[1.7] text-ink/86">{m.text}</span>
                  </li>
                ))}
              </ul>
              <ProposalPhotos photos={d.photos} class="mt-12" />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  route && (
    <section class="bg-white">
      <div class:list={[sectionBox, "grid items-start gap-16 md:grid-cols-[11rem_1fr] md:gap-32"]}>
        <div class="w-32 md:w-full">
          <svg viewBox="468 140 272 800" role="img" aria-label={route.mapLabel ?? route.title} class="aspect-[272/800] h-auto w-full rounded-lg">
            <rect x="0" y="0" width="1000" height="1100" class="fill-ink/10"></rect>
            {LAND.map((d) => <path d={d} class="fill-surface stroke-ink/20" stroke-width=".8" />)}
            <path d={ROUTE_D} fill="none" class="stroke-ink/25" stroke-width="2" stroke-dasharray="4 5"></path>
            <path d={ROUTE_D} fill="none" class="stroke-ink" stroke-width="4" stroke-linecap="round" pathLength="1" stroke-dasharray={`${drawn} 2`}></path>
            {stops.map((s) => (
              <g>
                <circle cx={s.x} cy={s.y} r="11" class="fill-ink stroke-surface" stroke-width="2"></circle>
                <text x={s.x} y={s.y + 4.5} text-anchor="middle" class="fill-white font-sans text-[12px] font-semibold">{s.n}</text>
              </g>
            ))}
          </svg>
        </div>
        <div>
          {route.eyebrow && <p class={eyebrow} data-tina-field={tinaField(route, "eyebrow")}>{route.eyebrow}</p>}
          <h2 class={`mt-7 ${h2}`} data-tina-field={tinaField(route, "title")}>{route.title}</h2>
          {route.dates && <p class="mt-8 text-[.85rem] text-ink/78" data-tina-field={tinaField(route, "dates")}>{route.dates}</p>}
          <ol class="mt-14 border-t border-ink/14" data-tina-field={tinaField(route, "stops")}>
            {stops.map((s) => (
              <li class="grid grid-cols-[2.2rem_1fr] border-b border-ink/14 py-6">
                <span class="row-span-2 grid size-[1.3rem] place-items-center rounded-full bg-ink font-mono text-[.6rem] text-white">{s.n}</span>
                <strong class="font-serif text-[.95rem] font-medium">{s.name}</strong>
                <span class="mt-1 text-[.74rem] text-ink/64">{s.sub}</span>
              </li>
            ))}
          </ol>
          {(route.facts?.length ?? 0) > 0 && (
            <ul class="mt-10 space-y-3 text-[.8rem] text-ink/86" data-tina-field={tinaField(route, "facts")}>
              {route.facts.map((fact: string) => <li>{fact}</li>)}
            </ul>
          )}
          {route.note && <p class="mt-10 max-w-[55ch] text-[.7rem] leading-relaxed text-ink/64" data-tina-field={tinaField(route, "note")}>{route.note}</p>}
          {route.mapCredit && <p class="mt-4 text-[.68rem] text-ink/50" data-tina-field={tinaField(route, "mapCredit")}>{route.mapCredit}</p>}
        </div>
      </div>
    </section>
  )
}

{
  options.length > 0 && (
    <section class="bg-surface">
      <div class:list={[sectionBox, "group/boats"]}>
        {boat.eyebrow && <p class={eyebrow} data-tina-field={tinaField(boat, "eyebrow")}>{boat.eyebrow}</p>}
        <h2 class={`mt-7 ${h2}`} data-tina-field={tinaField(boat, "title")}>{boat.title}</h2>
        {options.length > 1 && (
          <fieldset class="mt-16">
            {boat.choose && <legend class={`${eyebrow} mb-5`} data-tina-field={tinaField(boat, "choose")}>{boat.choose}</legend>}
            <div class="flex flex-wrap gap-4">
              {options.map((o, i) => (
                <div class="relative">
                  <input type="radio" name="boat" id={`boat-${i}`} class="peer absolute inset-0 size-full cursor-pointer opacity-0" checked={i === 0} />
                  <label for={`boat-${i}`} class="block rounded border border-ink/26 bg-white px-5 py-2.5 text-[.75rem] font-medium text-ink transition duration-500 ease-soft peer-checked:bg-ink peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink">{o.name}</label>
                </div>
              ))}
            </div>
          </fieldset>
        )}
        {options.map((o, i) => {
          const photos = photosOf(o);
          const banner = o.banner || photos[0]?.src;
          const specs = ((o.specs ?? []) as any[]).filter((x) => x?.label && x?.value);
          const features = ((o.featureList ?? []) as (string | null)[]).filter((f): f is string => !!f);
          return (
            <article class:list={["mt-20 space-y-16", options.length > 1 ? `hidden ${showPanel[i] ?? ""}` : ""]} data-tina-field={tinaField(o)}>
              {banner && (
                <div class="aspect-[16/9] overflow-hidden rounded-lg bg-ink md:aspect-[21/9]">
                  <img src={banner} alt={o.bannerAlt || o.name} loading="lazy" decoding="async" class="h-full w-full object-cover object-center" data-tina-field={tinaField(o, "banner")} />
                </div>
              )}
              <div class:list={["grid items-start gap-14", photos.length > 0 ? "lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-24" : ""]}>
                {photos.length > 0 && (
                  <div class="relative aspect-[4/5] overflow-hidden rounded-lg border border-ink/14 bg-white">
                    <ImageSlider client:visible photos={photos} previousLabel={modal?.previous ?? ""} nextLabel={modal?.next ?? ""} dotLabel={modal?.photo ?? ""} dotsAt="bottom" fit="contain" tone="light" className="h-full w-full" />
                  </div>
                )}
                <div>
                  {o.tag && <p class="mb-5 w-fit rounded-sm bg-ink px-[.7rem] py-[.35rem] font-mono text-[.58rem] tracking-[.12em] text-white uppercase" data-tina-field={tinaField(o, "tag")}>{o.tag}</p>}
                  <h3 class="font-display text-[1.3rem] leading-tight" data-tina-field={tinaField(o, "name")}>{o.name}</h3>
                  {o.type && <p class="mt-3 font-serif text-[.95rem] text-ink/64 italic" data-tina-field={tinaField(o, "type")}>{o.type}</p>}
                  {o.dates && <p class="mt-1.5 text-[.75rem] text-ink/64" data-tina-field={tinaField(o, "dates")}>{o.dates}</p>}
                  {o.about && <p class="mt-8 max-w-[52ch] text-[.8rem] leading-[1.8] text-ink/74" data-tina-field={tinaField(o, "about")}>{o.about}</p>}
                  {specs.length > 0 && (
                    <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-6 border-y border-ink/10 py-7 sm:grid-cols-4">
                      {specs.map((x) => (
                        <div>
                          <dt class="mb-1.5 font-mono text-[.55rem] tracking-[.14em] text-ink/45 uppercase">{x.label}</dt>
                          <dd class="font-display text-[.9rem] text-ink">{x.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  {features.length > 0 && (
                    <ul class="mt-8 grid gap-x-8 gap-y-2.5 text-[.76rem] text-ink/74 sm:grid-cols-2" data-tina-field={tinaField(o, "featureList")}>
                      {features.map((f) => <li class="flex gap-2"><span class="text-ink/35" aria-hidden="true">—</span>{f}</li>)}
                    </ul>
                  )}
                  {o.similarNote && <p class="mt-6 text-[.72rem] leading-relaxed text-ink/64" data-tina-field={tinaField(o, "similarNote")}>{o.similarNote}</p>}
                  <div class="mt-14 border-t border-ink/14 pt-8">
                    {boat.priceLabel && <p class={eyebrow} data-tina-field={tinaField(boat, "priceLabel")}>{boat.priceLabel}</p>}
                    <p class="mt-5 font-display text-[clamp(1.7rem,2.6vw,2.2rem)] leading-none" data-tina-field={tinaField(o, "price")}>{o.price}</p>
                    {o.priceNote && <p class="mt-4 text-[.75rem] text-ink/64" data-tina-field={tinaField(o, "priceNote")}>{o.priceNote}</p>}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
        {boat.note && <p class="mt-16 max-w-[60ch] text-[.7rem] leading-relaxed text-ink/64" data-tina-field={tinaField(boat, "note")}>{boat.note}</p>}
        {reserveHref && reserveLabel && (
          <div class="mt-16">
            <Button href={reserveHref} variant="primary" size="sm">{reserveLabel}</Button>
          </div>
        )}
      </div>
    </section>
  )
}

{
  offer && (
    <section class="bg-white">
      <div class={sectionBox}>
        {offer.eyebrow && <p class={eyebrow} data-tina-field={tinaField(offer, "eyebrow")}>{offer.eyebrow}</p>}
        <h2 class={`mt-7 ${h2}`} data-tina-field={tinaField(offer, "title")}>{offer.title}</h2>
        {offer.crew && <p class="mt-8 max-w-[52ch] text-[.85rem] leading-relaxed text-ink/78" data-tina-field={tinaField(offer, "crew")}>{offer.crew}</p>}
        <div class="mt-20 grid gap-16 md:grid-cols-3 md:gap-24">
          {[
            { title: offer.includedTitle, items: offer.included, field: "included", tone: "text-ink/86" },
            { title: offer.alsoTitle, items: offer.also, field: "also", tone: "text-ink/86" },
            { title: offer.excludedTitle, items: offer.excluded, field: "excluded", tone: "text-ink/64" },
          ].map((col) => (
            (col.items?.length ?? 0) > 0 && (
              <div>
                {col.title && <h3 class={`${eyebrow} border-t border-ink/14 pt-6 pb-6`}>{col.title}</h3>}
                <ul class:list={["space-y-3.5 text-[.78rem] leading-relaxed", col.tone]} data-tina-field={tinaField(offer, col.field)}>
                  {col.items.map((item: string) => <li>{item}</li>)}
                </ul>
              </div>
            )
          ))}
        </div>
        <ProposalPhotos photos={offer.gallery} class="mt-20" />
        {(offer.terms?.length ?? 0) > 0 && (
          <dl class="mt-24 border-t border-ink/14">
            {offer.terms.map((t: any) => (
              <div class="grid gap-2 border-b border-ink/14 py-7 md:grid-cols-[13rem_1fr] md:gap-6" data-tina-field={tinaField(t)}>
                <dt class={`${eyebrow} pt-1`}>{t.label}</dt>
                <dd class="text-[.8rem] text-ink/86">{t.text}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </section>
  )
}

{
  crew && crewMembers.length > 0 && (
    <section class="bg-white">
      <div class:list={[sectionBox, "grid items-start gap-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-28"]}>
        <div class="lg:sticky lg:top-28">
          <h2 class="font-display text-[clamp(1.5rem,3.2vw,2.5rem)] leading-[1.15] text-ink" data-tina-field={tinaField(crew, "title")}>
            {crew.title}
            {crew.titleEmphasis && (<><br /><em class="not-italic text-ink/50" data-tina-field={tinaField(crew, "titleEmphasis")}>{crew.titleEmphasis}</em></>)}
          </h2>
          {crew.blurb && <p class="mt-8 max-w-[46ch] text-[.8rem] leading-[1.8] text-ink/74" data-tina-field={tinaField(crew, "blurb")}>{crew.blurb}</p>}
          {crew.linkLabel && crew.linkHref && <p class="mt-6"><a href={crew.linkHref} class="text-[.8rem] font-medium text-ink underline underline-offset-4">{crew.linkLabel}</a></p>}
        </div>
        <div class="min-w-0">
          <div class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-crew-showcase tabindex="0" role="group" aria-label={crew.title}>
            {crewMembers.map((member: any) => <CrewSummaryCard member={member} labels={crewSection.data.crewSection} locale={locale} />)}
          </div>
          <SliderDots client:visible sliderSelector="[data-crew-showcase]" cardSelector=".crew-card" count={crewMembers.length} labelPrefix={crewSection.data.crewSection.dotsLabel ?? ""} />
          {crew.note && <p class="mt-10 max-w-[58ch] text-[.74rem] leading-[1.8] text-ink/64" data-tina-field={tinaField(crew, "note")}>{crew.note}</p>}
        </div>
      </div>
    </section>
  )
}

{
  practical && (practical.items?.length ?? 0) > 0 && (
    <section class="bg-surface">
      <div class={sectionBox}>
        {practical.eyebrow && <p class={eyebrow} data-tina-field={tinaField(practical, "eyebrow")}>{practical.eyebrow}</p>}
        <h2 class={`mt-7 ${h2}`} data-tina-field={tinaField(practical, "title")}>{practical.title}</h2>
        <div class="mt-24 grid gap-x-24 gap-y-20 md:grid-cols-2">
          {practical.items.map((it: any) => (
            <div class="border-t border-ink/14 pt-8" data-tina-field={tinaField(it)}>
              <h3 class="font-display text-[1.05rem] leading-tight" data-tina-field={tinaField(it, "title")}>{it.title}</h3>
              <div class="mt-5 space-y-4 text-[.8rem] leading-[1.85] text-ink/74" data-tina-field={tinaField(it, "text")}>
                {paragraphs(it.text).map((p) => <p>{p}</p>)}
              </div>
              <ProposalPhotos photos={it.photos} class="mt-8" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  faq && (faq.items?.length ?? 0) > 0 && (
    <section class="bg-white">
      <div class:list={[sectionBox, "grid gap-16 md:grid-cols-[1fr_1.6fr] md:gap-32"]}>
        <div>
          {faq.eyebrow && <p class={eyebrow} data-tina-field={tinaField(faq, "eyebrow")}>{faq.eyebrow}</p>}
          <h2 class={`mt-7 ${h2}`} data-tina-field={tinaField(faq, "title")}>{faq.title}</h2>
        </div>
        <div class="border-t border-ink/14">
          {faq.items.map((q: any) => (
            <details class="group border-b border-ink/14 py-7" data-tina-field={tinaField(q)}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-8 text-[.9rem] font-medium text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink [&::-webkit-details-marker]:hidden">
                <span data-tina-field={tinaField(q, "question")}>{q.question}</span>
                <span class="text-xl leading-none text-ink/50 transition duration-500 ease-soft group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-6 max-w-[58ch] text-[.8rem] leading-[1.9] text-ink/74" data-tina-field={tinaField(q, "answer")}>{q.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  reserve && (
    <section class="relative isolate overflow-hidden bg-ink text-white">
      {reserve.image && <img src={reserve.image} alt="" loading="lazy" decoding="async" class="absolute inset-0 z-[-1] h-full w-full object-cover" data-tina-field={tinaField(reserve, "image")} />}
      <div class="absolute inset-0 z-[-1] bg-ink/70"></div>
      <div class="mx-auto max-w-[40rem] px-5 py-[calc(var(--spacing-section)*4)] text-center">
        <h2 class={`${h2} text-white`} data-tina-field={tinaField(reserve, "title")}>{reserve.title}</h2>
        {reserve.lede && <p class="mx-auto mt-9 max-w-[44ch] text-[.9rem] leading-relaxed text-white/86" data-tina-field={tinaField(reserve, "lede")}>{reserve.lede}</p>}
        {reserveHref && reserveLabel && (
          <div class="mt-14">
            <Button href={reserveHref} variant="primary" context="hero" data-tina-field={tinaField(reserve, "button")}>{reserveLabel}</Button>
          </div>
        )}
        {reserve.note && <p class="mx-auto mt-10 max-w-[46ch] text-[.7rem] leading-relaxed text-white/64" data-tina-field={tinaField(reserve, "note")}>{reserve.note}</p>}
        {(reserve.agentLine || (reserve.contacts?.length ?? 0) > 0) && (
          <div class="mt-20 border-t border-white/20 pt-10 text-[.74rem] text-white/78">
            {reserve.agentLine && <p data-tina-field={tinaField(reserve, "agentLine")}>{reserve.agentLine}</p>}
            {(reserve.contacts?.length ?? 0) > 0 && (
              <ul class="mt-5 flex flex-wrap items-center justify-center gap-x-10 gap-y-3">
                {reserve.contacts.map((c: any) => (
                  <li data-tina-field={tinaField(c)}><a href={c.href} class="underline underline-offset-4 hover:text-white">{c.label}: {c.value}</a></li>
                ))}
              </ul>
            )}
          </div>
        )}
      </div>
    </section>
  )
}

{
  legal && (
    <p class={`mx-auto max-w-site ${gutter} py-16 text-[.68rem] leading-[1.8] text-ink/50`} data-tina-field={tinaField(proposal, "legal")}>{legal}</p>
  )
}
