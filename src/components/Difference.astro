---
/**
 * Difference — `<section class="section" id="difference">` in the source
 * index.html (lines 112-155), CSS at styles.css "9. DIFFERENCE / CONCEPT"
 * (L1082-1244) plus the shared `.section`/`.section-head`/`.kicker`/`.h2`/
 * `.lede` rules (L221-334) that this is the first component to use.
 *
 * `.section`/`.section-head` are inlined here, not extracted into a shared
 * wrapper yet — crew/wildlife/boats will need the exact same shell, but
 * I'd rather confirm the real shared shape across 2-3 concrete sections
 * than guess an abstraction from this one.
 *
 * `[data-reveal]`/`.reveal` (both used here) now live in global.css as
 * real CSS (stateful, JS-toggled — can't be a Tailwind utility). Until
 * Nav/chrome wires main.js's initReveals(), every [data-reveal]/.reveal
 * element on the page renders in its pre-reveal (invisible) state — this
 * is expected right now, not a bug in this component.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import type { DifferenceQuery } from "../../tina/__generated__/types";

interface Props {
  difference: DifferenceQuery["difference"];
}

const { difference } = Astro.props;
const { founderQuote } = difference;
---

<section
  class="section relative mx-auto max-w-site border-t border-ink/8 py-section pr-pad pl-[calc(var(--spacing-pad)+var(--rail))]"
  id="difference"
  data-depth-stop={difference.depth?.meters ?? undefined}
  data-depth-name={difference.depth?.name ?? undefined}
>
  <div class="mb-section-head grid items-center gap-10 md:grid-cols-2 md:gap-16">
    <div class="section-head">
      <p class="kicker mb-[1.1rem] flex items-center gap-[.6rem] font-mono text-[.76rem] tracking-[.14em] text-ink/64 uppercase" data-reveal>
        {
          difference.kickerNumber && (
            <span class="text-ink" data-tina-field={tinaField(difference, "kickerNumber")}>
              {difference.kickerNumber}
            </span>
          )
        }
        <span data-tina-field={tinaField(difference, "kicker")}>{difference.kicker}</span>
      </p>
      <h2 class="h2 text-h2" data-reveal data-tina-field={tinaField(difference, "title")}>
        {difference.title}
        {
          difference.titleEmphasis && (
            <>
              <br />
              <em class="not-italic text-ink" data-tina-field={tinaField(difference, "titleEmphasis")}>
                {difference.titleEmphasis}
              </em>
            </>
          )
        }
      </h2>
      {
        difference.lede && (
          <p
            class="lede mt-[1.2rem] max-w-[58ch] text-lede text-ink/74 opacity-[.92]"
            data-reveal
            data-tina-field={tinaField(difference, "lede")}
          >
            {difference.lede}
          </p>
        )
      }
    </div>
    {
      difference.image && (
        <img
          src={difference.image}
          alt={difference.imageAlt ?? ""}
          loading="lazy"
          decoding="async"
          class="reveal aspect-[4/5] w-full rounded-lg object-cover object-[50%_80%]"
          data-tina-field={tinaField(difference, "image")}
        />
      )
    }
  </div>

  {
    founderQuote && (
      <div class="founder-quote reveal relative isolate mt-quote py-quote text-center">
        {
          founderQuote.kicker && (
            <p
              class="founder-quote-kicker mb-[1.6rem] font-serif text-quote-lead text-ink/64 italic whitespace-pre-line"
              data-tina-field={tinaField(founderQuote, "kicker")}
            >
              {founderQuote.kicker}
            </p>
          )
        }
        <p class="founder-quote-mark font-serif text-[5rem] leading-none text-ink opacity-[.25]" aria-hidden="true">
          &quot;
        </p>
        <blockquote class="mx-auto max-w-[60rem]">
          {
            founderQuote.quote && (
              <p
                class="font-serif text-quote text-ink italic leading-[1.3]"
                data-tina-field={tinaField(founderQuote, "quote")}
              >
                {founderQuote.quote}
              </p>
            )
          }
          {
            founderQuote.cite && (
              <cite
                class="mt-[1.4rem] block font-mono text-[.8rem] tracking-[.06em] text-ink/64 not-italic"
                data-tina-field={tinaField(founderQuote, "cite")}
              >
                {founderQuote.cite}
              </cite>
            )
          }
        </blockquote>
      </div>
    )
  }
</section>
