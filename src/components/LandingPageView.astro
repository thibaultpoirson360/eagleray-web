---
/**
 * `/en/landing/<slug>/` — free-form landing pages composed from
 * tina/collections/landingPage.ts's `blocks` list. Thin content component
 * (not inlined in the page route), matching every other page's own
 * pattern: the on-demand island-refresh route
 * (src/pages/tina-island/[name].ts) needs a component reference to
 * re-render for live editing.
 *
 * Judgment call: `title` always renders as a plain heading above the
 * blocks, unconditionally — the same behaviour blogPost's and
 * contactPage's own `title` fields already have (BlogPostView.astro,
 * ContactPage.astro), kept consistent here rather than invented specially
 * for this collection. One known consequence, flagged rather than
 * silently handled: if an editor also adds a `hero` block as the very
 * first block, the page shows this plain heading immediately followed by
 * a full hero band, which can read as a redundant double heading.
 * Suppressing the header conditionally when block[0] is a hero was
 * considered and rejected — it would make `title`'s rendering depend on
 * unrelated content elsewhere on the page, exactly the kind of implicit,
 * easy-to-miss state CLAUDE.md's "list out loud every state" discipline
 * warns against. Flag back if a conditional header (or making `title`
 * pure `<title>`-tag metadata with no forced on-page heading) is actually
 * wanted — the latter would also mean `title` is only editable via Tina's
 * sidebar form, not click-to-edit in the visual iframe, since contextual
 * editing needs a rendered, visible node to attach to.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import LandingPageBlocks from "./landing/LandingPageBlocks.astro";
import type { LandingPageQuery } from "../../tina/__generated__/types";

interface Props {
  landingPage: LandingPageQuery["landingPage"];
}

const { landingPage } = Astro.props;
---

<!-- <header class="relative mx-auto max-w-site border-t border-ink/8 px-pad pt-16 pb-10 sm:pt-20">
  <h1 class="font-display text-h2" data-tina-field={tinaField(landingPage, "title")}>
    {landingPage.title}
  </h1>
</header> -->
<LandingPageBlocks landingPage={landingPage} />
