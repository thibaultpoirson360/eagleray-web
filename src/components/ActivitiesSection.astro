---
/**
 * "Add activities to your expedition": a grid of activity cards under the
 * expedition cards on Sail with Us (anchor #activities). Each card's button
 * opens the contact form with that activity's message already written
 * (`?message=`, read by ContactForm.tsx). All text comes from the page's
 * content; the price note is shown small, only where an editor writes one.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import Button from "./ui/Button.astro";
import { localePath, type Locale } from "../i18n/config";
import type { SailWithUsPageQuery } from "../../tina/__generated__/types";

interface Props {
  page: SailWithUsPageQuery["sailWithUsPage"];
  locale: Locale;
}

const { page, locale } = Astro.props;
// Only activities that already have a photo are shown, so the page never has empty dark squares. Add a photo in the editor and the card appears.
const activities = (page.activities ?? []).flatMap((activity, i) => (activity?.name && activity.image ? [{ activity, i }] : []));
// Main activities ("Large card") come first, two per row; the rest follow three per row.
const large = activities.filter(({ activity }) => activity.featured);
const regular = activities.filter(({ activity }) => !activity.featured);
const contactHref = (message?: string | null) =>
  localePath(locale, "contact/") + (message ? `?message=${encodeURIComponent(message)}` : "");
---

<section id="activities" class="mx-auto max-w-site px-5 pb-[calc(var(--spacing-section)*1.4)] pt-[calc(var(--spacing-section)*.6)] lg:px-[calc(var(--spacing-pad)+var(--rail))]">
  <div class="mb-[calc(var(--spacing-section-head)*1.2)] text-center">
    <h2 class="text-quote-lead leading-[1.35] font-normal" data-tina-field={tinaField(page, "activitiesTitle")}>{page.activitiesTitle}</h2>
    {
      page.activitiesSubtitle && (
        <p class="mx-auto mt-5 max-w-[46ch] text-[.92rem] leading-[1.8] text-ink/64" data-tina-field={tinaField(page, "activitiesSubtitle")}>
          {page.activitiesSubtitle}
        </p>
      )
    }
  </div>

  {
    [
      { items: large, columns: large.length === 1 ? "" : "md:grid-cols-2", big: true },
      { items: regular, columns: regular.length === 1 ? "" : regular.length === 2 ? "md:grid-cols-2" : "md:grid-cols-2 lg:grid-cols-3", big: false },
    ].map(
      (group) =>
        group.items.length > 0 && (
          <ul
            class={`-mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [-webkit-overflow-scrolling:touch] [scrollbar-width:none] md:mx-0 md:grid md:gap-8 md:overflow-visible md:px-0 md:pb-0 [&::-webkit-scrollbar]:hidden ${group.columns} ${group.big ? "" : "mt-8"}`}
            tabindex="0"
            role="group"
            aria-label={page.activitiesTitle ?? undefined}
          >
            {group.items.map(({ activity, i }) => (
              <li
                class="group relative flex w-[82%] flex-none snap-start flex-col overflow-hidden rounded-lg border border-ink/14 bg-white md:w-auto"
                data-tina-field={tinaField(page, "activities", i)}
              >
                {/* The whole photo shows. On hover or keyboard focus a white banner rises from the bottom with the explanation and the button. On touch screens (no hover) the banner sits under the photo instead. */}
                <div class={`relative w-full overflow-hidden bg-ink ${group.big ? "aspect-[16/10]" : "aspect-[4/3]"}`}>
                  {activity.image ? (
                    <img src={activity.image} alt={activity.imageAlt ?? ""} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                  ) : (
                    <p class="flex h-full items-center justify-center font-mono text-[.76rem] tracking-[.14em] text-white/60">
                      {activity.imageNote}
                    </p>
                  )}
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/65 via-transparent to-transparent [@media(hover:none)]:hidden" />
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute top-4 right-4 flex size-8 items-center justify-center rounded-full bg-white/90 text-ink transition-opacity duration-500 group-focus-within:opacity-0 group-hover:opacity-0 [@media(hover:none)]:hidden"
                  >
                    +
                  </span>
                  <p
                    aria-hidden="true"
                    class={`pointer-events-none absolute right-5 bottom-5 left-5 font-display text-white [@media(hover:none)]:hidden ${group.big ? "text-[1.75rem]" : "text-[1.35rem]"}`}
                  >
                    {activity.name}
                  </p>
                </div>
                <div
                  class={`absolute inset-x-0 bottom-0 flex translate-y-full flex-col bg-white transition-transform duration-500 ease-soft group-focus-within:translate-y-0 group-hover:translate-y-0 motion-reduce:transition-none [@media(hover:none)]:static [@media(hover:none)]:translate-y-0 ${group.big ? "p-8" : "p-6"}`}
                >
                  <h3 class={`font-display ${group.big ? "text-[1.75rem]" : "text-[1.35rem]"}`}>{activity.name}</h3>
                  {activity.text && (
                    <p class={`mt-3 leading-[1.6] text-ink/74 ${group.big ? "text-[1rem]" : "text-[.92rem]"}`}>{activity.text}</p>
                  )}
                  {activity.priceNote && <p class="mt-3 font-display text-[.9rem] font-normal text-ink/64">{activity.priceNote}</p>}
                  <div class="pt-5">
                    <Button
                      href={contactHref(activity.contactMessage)}
                      variant="ghost"
                      context="default"
                      size="sm"
                      class="border-ink! bg-transparent! text-ink transition-colors duration-500 group-focus-within:bg-ink! group-focus-within:text-white group-hover:bg-ink! group-hover:text-white hover:bg-ink-hover!"
                    >
                      {page.activitiesButtonLabel}
                    </Button>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )
    )
  }
</section>
