---
/**
 * A page-level hero banner: full-width photo under the standard dark
 * gradient, with an optional kicker, the page's <h1>, an optional
 * sub-headline and an optional button, bottom-left. Shared by the Passionate
 * Sea People page and the 404 page; any new inner page that opens with a hero
 * should use it rather than copy the markup.
 *
 * The gradient and type are the homepage Hero's (Hero.astro) — minus its
 * video, magnetic buttons and second CTA, which only the homepage needs. Its
 * text starts at the same left edge as the sections below (padding + the
 * depth-gauge rail) so the page has one column line. A page that opens with
 * this should keep BaseLayout's transparent nav (the default).
 *
 * `fields` carries Tina's click-to-edit markers, one per editable piece —
 * the caller builds them with tinaField(), since only it knows which
 * document the values come from.
 */
import Button from "./Button.astro";

interface Props {
  title: string;
  kicker?: string | null;
  lede?: string | null;
  image?: string | null;
  imageAlt?: string | null;
  cta?: { label: string; href: string } | null;
  fields?: { title?: string; kicker?: string; lede?: string; image?: string; cta?: string };
}

const { title, kicker, lede, image, imageAlt, cta, fields = {} } = Astro.props;
---

<section class="relative isolate flex min-h-[60vh] items-end overflow-hidden">
  <div class="absolute inset-0 z-[-1] bg-ink">
    {
      image && (
        <img
          src={image}
          alt={imageAlt ?? ""}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="h-full w-full object-cover"
          data-tina-field={fields.image}
        />
      )
    }
    <div class="absolute inset-0 bg-linear-to-b from-ink/25 via-ink/42 via-45% to-ink/82"></div>
  </div>
  <div class="relative mx-auto w-full max-w-site px-5 pt-32 pb-16 text-white lg:pr-pad lg:pl-[calc(var(--spacing-pad)+var(--rail))]">
    {
      kicker && (
        <p class="mb-[1.1rem] font-mono text-[.76rem] tracking-[.14em] text-white/82 uppercase" data-tina-field={fields.kicker}>
          {kicker}
        </p>
      )
    }
    <h1 class="max-w-[20ch] font-display text-hero text-white" data-tina-field={fields.title}>{title}</h1>
    {
      lede && (
        <p class="mt-[1.3rem] max-w-[50ch] text-hero-sub text-white/86" data-tina-field={fields.lede}>
          {lede}
        </p>
      )
    }
    {
      cta && (
        <div class="mt-[2.3rem]">
          <Button href={cta.href} variant="primary" context="hero" data-tina-field={fields.cta}>
            {cta.label}
          </Button>
        </div>
      )
    }
  </div>
</section>
