---
/**
 * A page-level hero banner: full-width photo under the standard dark
 * gradient, with an optional kicker, the page's <h1>, an optional
 * sub-headline and an optional button, bottom-left. Shared by the Passionate
 * Sea People page and the 404 page; any new inner page that opens with a hero
 * should use it rather than copy the markup.
 *
 * The gradient and type are the homepage Hero's (Hero.astro) — minus its
 * video, magnetic buttons and second CTA, which only the homepage needs. Its
 * text starts at the same left edge as the sections below (padding + the
 * depth-gauge rail) so the page has one column line. A page that opens with
 * this should keep BaseLayout's transparent nav (the default).
 *
 * `fields` carries Tina's click-to-edit markers, one per editable piece —
 * the caller builds them with tinaField(), since only it knows which
 * document the values come from.
 */
import Button from "./Button.astro";

interface Props {
  title: string;
  kicker?: string | null;
  lede?: string | null;
  image?: string | null;
  imageAlt?: string | null;
  /** A longer line under the sub-headline. */
  supporting?: string | null;
  cta?: { label: string; href: string } | null;
  /** "quiet": a smaller headline (the h2 size) and more room, for a calmer page. */
  tone?: "default" | "quiet";
  fields?: { title?: string; kicker?: string; lede?: string; supporting?: string; image?: string; cta?: string };
}

const { title, kicker, lede, image, imageAlt, supporting, cta, tone = "default", fields = {} } = Astro.props;
const quiet = tone === "quiet";
---

<section class:list={["relative isolate flex items-end overflow-hidden", quiet ? "min-h-[68vh]" : "min-h-[60vh]"]}>
  <div class="absolute inset-0 z-[-1] bg-ink">
    {
      image && (
        <img
          src={image}
          alt={imageAlt ?? ""}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="h-full w-full object-cover"
          data-tina-field={fields.image}
        />
      )
    }
    <div class="absolute inset-0 bg-linear-to-b from-ink/25 via-ink/42 via-45% to-ink/82"></div>
  </div>
  <div class:list={["relative mx-auto w-full max-w-site px-5 pt-32 text-white lg:pr-pad lg:pl-[calc(var(--spacing-pad)+var(--rail))]", quiet ? "pb-24" : "pb-16"]}>
    {
      kicker && (
        <p class="mb-[1.1rem] font-mono text-[.76rem] tracking-[.14em] text-white/82 uppercase" data-tina-field={fields.kicker}>
          {kicker}
        </p>
      )
    }
    <h1 class:list={["font-display text-white", quiet ? "max-w-[26ch] text-h2 leading-[1.2]" : "max-w-[20ch] text-hero"]} data-tina-field={fields.title}>{title}</h1>
    {
      lede && (
        <p class:list={["max-w-[50ch] text-hero-sub text-white/86", quiet ? "mt-8" : "mt-[1.3rem]"]} data-tina-field={fields.lede}>
          {lede}
        </p>
      )
    }
    {
      supporting && (
        <p class="mt-4 max-w-[60ch] text-lede text-white/78" data-tina-field={fields.supporting}>
          {supporting}
        </p>
      )
    }
    {
      cta && (
        <div class={quiet ? "mt-12" : "mt-[2.3rem]"}>
          <Button href={cta.href} variant="primary" context="hero" data-tina-field={fields.cta}>
            {cta.label}
          </Button>
        </div>
      )
    }
  </div>
</section>
