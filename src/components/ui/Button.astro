---
/**
 * Shared button — CLAUDE.md's locked mapping (base classes, primary/ghost ×
 * default/hero contexts, sm/wide variants). One component instead of
 * duplicating class sets at every call site; every future section that
 * needs a button reuses this rather than re-deriving the mapping.
 *
 * Each context/variant is a fully separate class string (not concatenated
 * conditionally) so conflicting utilities like bg-ink vs bg-white, or
 * px-7/py-4 vs px-5/py-2.5, never end up on the same element at once —
 * see docs/tailwind-migration-audit.md §2a.6.
 */
export interface Props {
  href?: string;
  variant?: "primary" | "ghost";
  context?: "default" | "hero";
  size?: "default" | "sm";
  wide?: boolean;
  /** Adds data-magnetic for main.js's pointer-follow effect (fine-pointer only, page chrome). */
  magnetic?: boolean;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
  /** Tina's click-to-edit marker — passed through since Astro doesn't auto-forward unlisted props. */
  "data-tina-field"?: string;
}

const {
  href,
  variant = "primary",
  context = "default",
  size = "default",
  wide = false,
  magnetic = false,
  type = "button",
  disabled = false,
  class: extraClass,
  "data-tina-field": tinaField,
} = Astro.props;

// One deliberate deviation from CLAUDE.md's locked base mapping: below `sm`
// the label may wrap (`whitespace-normal text-center`) instead of being
// `whitespace-nowrap` at every width. Spanish and French labels run long
// ("Te presentamos a nuestra gente apasionada por el mar" is 426px), and a
// button that can't wrap stretches the whole page wider than a phone.
// From `sm` up it is nowrap exactly as specified.
const base =
  "inline-flex items-center justify-center gap-2 rounded font-medium whitespace-normal text-center sm:whitespace-nowrap border border-transparent transition duration-500 ease-soft disabled:opacity-35 disabled:pointer-events-none";

const sizeClasses = {
  default: "px-7 py-4 text-sm",
  sm: "px-5 py-2.5 text-xs",
} as const;

const variantClasses = {
  default: {
    primary: "bg-ink text-white hover:bg-ink-hover hover:-translate-y-0.5",
    ghost: "border-ink/26 text-ink hover:bg-surface hover:border-ink hover:-translate-y-0.5",
  },
  hero: {
    primary: "bg-white text-ink hover:bg-surface hover:-translate-y-0.5",
    ghost: "border-white/45 text-white hover:bg-white/12 hover:border-white hover:-translate-y-0.5",
  },
} as const;

const classes = [
  base,
  sizeClasses[size],
  variantClasses[context][variant],
  wide ? "w-full" : "",
  extraClass ?? "",
]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a class={classes} href={href} data-magnetic={magnetic ? "" : undefined} data-tina-field={tinaField}>
      <slot />
    </a>
  ) : (
    <button
      class={classes}
      type={type}
      disabled={disabled}
      data-magnetic={magnetic ? "" : undefined}
      data-tina-field={tinaField}
    >
      <slot />
    </button>
  )
}
