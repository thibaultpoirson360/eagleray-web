---
/**
 * The About Us ("Our story") page, from the Claude Design mockup (About Us.dc.html).
 * Content comes from the aboutPage document (tina/collections/aboutPage.ts),
 * edited in the admin form. A blank line in a long text field starts a new
 * paragraph.
 */
import PageHero from "./ui/PageHero.astro";
import Button from "./ui/Button.astro";
import { paragraphs } from "../lib/crew";
import type { AboutPageQuery } from "../../tina/__generated__/types";

interface Props {
  aboutPage: AboutPageQuery["aboutPage"];
}

const { aboutPage } = Astro.props;
const story = paragraphs(aboutPage.storyBody);
const afterQuote = paragraphs(aboutPage.afterQuote);
const approach = paragraphs(aboutPage.approachBody);
---

<PageHero
  title={aboutPage.title}
  kicker={aboutPage.kicker}
  lede={aboutPage.lede}
  image={aboutPage.heroImage}
  imageAlt={aboutPage.heroImageAlt}
/>

<section class="relative mx-auto max-w-[700px] px-5 pt-section lg:px-0">
  {
    aboutPage.storyKicker && (
      <p class="mb-6 flex items-center gap-[.6rem] font-mono text-[.76rem] tracking-[.14em] text-ink/64 uppercase">
        <span class="size-1.5 rounded-full bg-ink" aria-hidden="true" />
        {aboutPage.storyKicker}
      </p>
    )
  }
  {aboutPage.storyTitle && <h2 class="mb-7 text-[clamp(26px,3.6vw,34px)]">{aboutPage.storyTitle}</h2>}
  <div class="space-y-5 text-[17px] leading-[1.75] text-ink/78">
    {story.map((p) => <p>{p}</p>)}
  </div>

  {
    aboutPage.founderImage && (
      <figure class="relative my-12 aspect-video w-full overflow-hidden rounded-[10px]">
        <img
          src={aboutPage.founderImage}
          alt={aboutPage.founderImageAlt ?? ""}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </figure>
    )
  }

  {
    aboutPage.quote && (
      <blockquote class="my-12 text-center">
        <p class="font-serif text-[clamp(20px,3vw,26px)] leading-[1.4] text-ink italic">“{aboutPage.quote}”</p>
      </blockquote>
    )
  }

  <div class="space-y-5 text-[17px] leading-[1.75] text-ink/78">
    {afterQuote.map((p) => <p>{p}</p>)}
  </div>
</section>

<section class="relative mx-auto max-w-[700px] border-t border-ink/8 px-5 pt-section lg:px-0">
  {
    aboutPage.approachKicker && (
      <p class="mb-6 flex items-center gap-[.6rem] font-mono text-[.76rem] tracking-[.14em] text-ink/64 uppercase">
        <span class="size-1.5 rounded-full bg-ink" aria-hidden="true" />
        {aboutPage.approachKicker}
      </p>
    )
  }
  <div class="space-y-5 text-[17px] leading-[1.75] text-ink/78">
    {approach.map((p) => <p>{p}</p>)}
  </div>
</section>

<section class="relative mx-auto max-w-[800px] px-5 py-section text-center lg:px-0">
  {
    aboutPage.closingLine && (
      <p class="mb-8 font-serif text-[clamp(22px,3.4vw,30px)] leading-[1.35] text-ink italic">{aboutPage.closingLine}</p>
    )
  }
  {
    aboutPage.closingLabel && aboutPage.closingHref && (
      <Button href={aboutPage.closingHref} variant="primary" context="default">
        {aboutPage.closingLabel}
      </Button>
    )
  }
</section>
