---
/**
 * A private group proposal in the cinematic style (the `groupProposal`
 * collection): full-screen opening photo, then wide sections on the two brand
 * colours (navy and off-white) with big photos and a lot of air. Built mobile
 * first, since it is opened from WhatsApp. Every text and photo is a field.
 * Empty photo slots (the boat gallery, the food photos) show as quiet boxes an
 * editor can click to fill. The whole page is set in Open Sans (loaded by the
 * page route); the site header and footer keep the site's own fonts.
 *
 * The WhatsApp button's number is the one in Site settings, the same number
 * the floating WhatsApp button uses.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import Button from "./ui/Button.astro";
import ProposalPhotos from "./ProposalPhotos.astro";
import { loadSiteSettings } from "../lib/content";

interface Props {
  proposal: any;
  locale: string;
}

const { proposal } = Astro.props;
const { hero, brief, days, boat, aboard, crew, book, closing, footer } = proposal;
const settings = await loadSiteSettings();
const number = String(settings.data.siteSettings.contact?.whatsapp ?? "").replace(/\D/g, "");
const whatsapp = number ? `https://wa.me/${number}${closing?.message ? `?text=${encodeURIComponent(closing.message)}` : ""}` : "";
const paragraphs = (text?: string | null) => (text ?? "").split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
const list = (items?: (string | null)[] | null) => (items ?? []).filter((x): x is string => !!x);

const gutter = "px-5 lg:pr-pad lg:pl-[calc(var(--spacing-pad)+var(--rail))]";
const box = `relative mx-auto max-w-site ${gutter} py-[calc(var(--spacing-section)*2.4)]`;
const h2 = "text-[clamp(1.6rem,5.2vw,2.6rem)] leading-[1.15] font-semibold tracking-[-.01em]";
const body = "text-[.98rem] leading-[1.85]";
const small = "font-mono text-[.66rem] tracking-[.18em] uppercase";

const icons: Record<string, string> = {
  calendar: "M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z",
  people: "M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 6.5M18 14a6.5 6.5 0 0 1 3.5 6",
  pin: "M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 1 1 13 0c0 5.4-6.5 11-6.5 11ZM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z",
  clock: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 7v5l3 2",
};
const gallery = (boat?.gallery ?? []) as any[];
const [mainPhoto, ...restPhotos] = gallery;
---

<div class="bg-surface font-['Open_Sans',sans-serif] text-ink [&_*]:font-['Open_Sans',sans-serif]">
  <section class="relative isolate flex min-h-svh items-end overflow-hidden bg-ink text-white">
    {hero.image && <img src={hero.image} alt={hero.imageAlt ?? ""} loading="eager" decoding="async" fetchpriority="high" class="absolute inset-0 z-[-1] h-full w-full object-cover" data-tina-field={tinaField(hero, "image")} />}
    <div class="absolute inset-0 z-[-1] bg-linear-to-b from-ink/35 via-ink/25 via-40% to-ink/90"></div>
    <div class={`mx-auto w-full max-w-site ${gutter} pt-32 pb-16 md:pb-24`}>
      {hero.note && <p class={`${small} mb-6 text-white/80`} data-tina-field={tinaField(hero, "note")}>{hero.note}</p>}
      <h1 class="max-w-[15ch] text-[clamp(2.2rem,9vw,4.8rem)] leading-[1.04] font-semibold tracking-[-.02em] text-white" data-tina-field={tinaField(hero, "title")}>{hero.title}</h1>
      {hero.subtitle && <p class="mt-7 max-w-[40ch] text-[clamp(1rem,2.6vw,1.2rem)] leading-[1.6] text-white/88" data-tina-field={tinaField(hero, "subtitle")}>{hero.subtitle}</p>}
      {hero.button?.label && (
        <div class="mt-10">
          <Button href={hero.button.href} variant="primary" context="hero" data-tina-field={tinaField(hero, "button")}>{hero.button.label}</Button>
        </div>
      )}
    </div>
  </section>

  {
    brief && (
      <section class="bg-surface">
        <div class={box}>
          <h2 class={h2} data-tina-field={tinaField(brief, "title")}>{brief.title}</h2>
          <div class={`mt-10 max-w-[56ch] space-y-6 ${body} text-ink/80`} data-tina-field={tinaField(brief, "text")}>
            {paragraphs(brief.text).map((p) => <p>{p}</p>)}
          </div>
          <ul class="mt-20 grid gap-8 border-t border-ink/14 pt-12 md:grid-cols-4 md:gap-10">
            {((brief.facts ?? []) as any[]).filter(Boolean).map((f) => (
              <li class="flex items-center gap-5 md:flex-col md:items-start md:gap-6" data-tina-field={tinaField(f)}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-8 shrink-0 text-ink">
                  <path d={icons[f.icon ?? "calendar"] ?? icons.calendar}></path>
                </svg>
                <span class="text-[.98rem] leading-snug font-semibold" data-tina-field={tinaField(f, "text")}>{f.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    days && (
      <section class="bg-ink text-white">
        <div class={box}>
          <h2 class={`${h2} text-white`} data-tina-field={tinaField(days, "title")}>{days.title}</h2>
          <div class={`mt-10 max-w-[56ch] space-y-6 ${body} text-white/84`} data-tina-field={tinaField(days, "text")}>
            {paragraphs(days.text).map((p) => <p>{p}</p>)}
          </div>
          <ProposalPhotos photos={days.photos} class="mt-16" />
          {days.note && <p class="mt-10 max-w-[56ch] text-[.8rem] leading-relaxed text-white/64" data-tina-field={tinaField(days, "note")}>{days.note}</p>}
        </div>
      </section>
    )
  }

  {
    boat && (
      <section id="boat" class="scroll-mt-20 bg-surface">
        <div class={box}>
          <h2 class="text-[clamp(2.4rem,9vw,4.4rem)] leading-none font-semibold tracking-[-.02em]" data-tina-field={tinaField(boat, "title")}>{boat.title}</h2>
          {boat.intro && <p class={`mt-8 max-w-[52ch] ${body} text-ink/80`} data-tina-field={tinaField(boat, "intro")}>{boat.intro}</p>}
          <div class="mt-16">
            {mainPhoto && (
              <>
                {mainPhoto.image ? (
                  <img src={mainPhoto.image} alt={mainPhoto.alt ?? ""} loading="lazy" decoding="async" class="aspect-[4/3] w-full rounded-lg object-cover md:aspect-[21/9]" data-tina-field={tinaField(mainPhoto, "image")} />
                ) : (
                  <div class="aspect-[4/3] w-full rounded-lg bg-ink/8 md:aspect-[21/9]" data-tina-field={tinaField(mainPhoto, "image")}></div>
                )}
              </>
            )}
            <ProposalPhotos photos={restPhotos} slots class="mt-3 md:mt-6" />
          </div>
          {boat.specs && <p class={`${small} mt-12 text-ink/64`} data-tina-field={tinaField(boat, "specs")}>{boat.specs}</p>}
          {(boat.cabins?.length ?? 0) > 0 && (
            <dl class="mt-10 border-t border-ink/14">
              {boat.cabins.map((c: any) => (
                <div class="grid gap-1 border-b border-ink/14 py-5 sm:grid-cols-[14rem_1fr] sm:gap-6" data-tina-field={tinaField(c)}>
                  <dt class="font-semibold" data-tina-field={tinaField(c, "who")}>{c.who}</dt>
                  <dd class="text-ink/80" data-tina-field={tinaField(c, "cabin")}>{c.cabin}</dd>
                </div>
              ))}
            </dl>
          )}
          {(boat.prices?.length ?? 0) > 0 && (
            <div class="mt-16 grid gap-px overflow-hidden rounded-lg bg-white/20 md:grid-cols-2">
              {boat.prices.map((pr: any) => (
                <div class="bg-ink p-8 text-white md:p-10" data-tina-field={tinaField(pr)}>
                  <p class={`${small} text-white/70`} data-tina-field={tinaField(pr, "label")}>{pr.label}</p>
                  <p class="mt-6 text-[clamp(1.5rem,5vw,2.1rem)] leading-tight font-semibold" data-tina-field={tinaField(pr, "total")}>{pr.total}</p>
                  <p class="mt-2 text-white/78" data-tina-field={tinaField(pr, "perPerson")}>{pr.perPerson}</p>
                </div>
              ))}
            </div>
          )}
          {boat.priceNote && <p class="mt-6 max-w-[56ch] text-[.85rem] leading-relaxed text-ink/70" data-tina-field={tinaField(boat, "priceNote")}>{boat.priceNote}</p>}
        </div>
      </section>
    )
  }

  {
    aboard && (
      <section class="bg-ink text-white">
        <div class={box}>
          <h2 class={`${h2} text-white`} data-tina-field={tinaField(aboard, "title")}>{aboard.title}</h2>
          <div class="mt-16 grid gap-16 md:grid-cols-2 md:gap-24">
            <div>
              {aboard.onTitle && <h3 class={`${small} border-t border-white/20 pt-6 pb-7 text-white/70`} data-tina-field={tinaField(aboard, "onTitle")}>{aboard.onTitle}</h3>}
              <ul class="space-y-4 text-[.95rem] leading-[1.7] text-white/90" data-tina-field={tinaField(aboard, "onBoard")}>
                {list(aboard.onBoard).map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              {aboard.offTitle && <h3 class={`${small} border-t border-white/20 pt-6 pb-7 text-white/70`} data-tina-field={tinaField(aboard, "offTitle")}>{aboard.offTitle}</h3>}
              <ul class="space-y-4 text-[.95rem] leading-[1.7] text-white/70" data-tina-field={tinaField(aboard, "notOnBoard")}>
                {list(aboard.notOnBoard).map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    crew && (
      <section class="bg-surface">
        <div class={box}>
          <h2 class={h2} data-tina-field={tinaField(crew, "title")}>{crew.title}</h2>
          <div class={`mt-10 max-w-[56ch] space-y-6 ${body} text-ink/80`} data-tina-field={tinaField(crew, "text")}>
            {paragraphs(crew.text).map((p) => <p>{p}</p>)}
          </div>
          <ProposalPhotos photos={crew.photos} slots class="mt-16" />
        </div>
      </section>
    )
  }

  {
    book && (
      <section class="bg-ink text-white">
        <div class={box}>
          <h2 class={`${h2} text-white`} data-tina-field={tinaField(book, "title")}>{book.title}</h2>
          {book.text && <p class={`mt-10 max-w-[56ch] ${body} text-white/84`} data-tina-field={tinaField(book, "text")}>{book.text}</p>}
          <ul class="mt-14 max-w-[60ch] border-t border-white/20" data-tina-field={tinaField(book, "terms")}>
            {list(book.terms).map((t) => <li class="border-b border-white/20 py-6 text-[.95rem] leading-[1.75] text-white/90">{t}</li>)}
          </ul>
        </div>
      </section>
    )
  }

  {
    closing && (
      <section class="bg-surface">
        <div class={`${box} text-center`}>
          <h2 class={`${h2} mx-auto`} data-tina-field={tinaField(closing, "title")}>{closing.title}</h2>
          {closing.text && <p class={`mx-auto mt-8 max-w-[44ch] ${body} text-ink/80`} data-tina-field={tinaField(closing, "text")}>{closing.text}</p>}
          {whatsapp && closing.buttonLabel && (
            <div class="mt-12">
              <Button href={whatsapp} variant="primary" data-tina-field={tinaField(closing, "buttonLabel")}>{closing.buttonLabel}</Button>
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    footer && (
      <div class="bg-ink text-white">
        <div class={`mx-auto max-w-site ${gutter} space-y-2 py-12 text-center text-[.8rem] leading-relaxed text-white/70`}>
          {footer.line1 && <p data-tina-field={tinaField(footer, "line1")}>{footer.line1}</p>}
          {footer.line2 && <p data-tina-field={tinaField(footer, "line2")}>{footer.line2}</p>}
        </div>
      </div>
    )
  }
</div>
