---
/**
 * The La Paz page, built from the Claude Design mockup (La Paz.dc.html).
 * Content comes entirely from the laPage document (tina/collections/laPage.ts),
 * edited in the admin form — there is no visual-editing wrapper on this page.
 *
 * The wildlife cards and the "Where we go" places open their photo larger in
 * a modal (ImageCards.tsx). Each card is also a plain link to the photo, so
 * it works with no JavaScript.
 */
import ImageCards from "./ImageCards.tsx";
import PageHero from "./ui/PageHero.astro";
import Button from "./ui/Button.astro";
import type { LaPageQuery } from "../../tina/__generated__/types";

interface Props {
  laPage: LaPageQuery["laPage"];
}

const { laPage } = Astro.props;
const species = (laPage.species ?? []).filter((s): s is NonNullable<typeof s> => !!s?.name);
const places = (laPage.destinations ?? []).filter((d): d is NonNullable<typeof d> => !!d?.name);
const facts = (laPage.facts ?? []).filter((f): f is NonNullable<typeof f> => !!f?.label);
---

<PageHero
  title={laPage.title}
  kicker={laPage.metaLine}
  lede={laPage.lede}
  image={laPage.heroImage}
  imageAlt={laPage.heroImageAlt}
/>

{
  facts.length > 0 && (
    <section class="relative mx-auto max-w-site px-5 pt-16 lg:px-pad">
      <dl class="grid gap-x-4 gap-y-6 border-t border-ink/14 pt-6 [grid-template-columns:repeat(auto-fit,minmax(160px,1fr))]">
        {facts.map((f) => (
          <div>
            <dt class="mb-1 font-mono text-[.62rem] tracking-[.14em] text-ink/64 uppercase">{f.label}</dt>
            <dd class="m-0 text-[.95rem] text-ink">{f.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<section class="relative mx-auto max-w-site py-section px-5 lg:px-pad">
  {
    laPage.wildlifeKicker && (
      <p class="mb-[1.1rem] flex items-center gap-[.6rem] font-mono text-[.76rem] tracking-[.14em] text-ink/64 uppercase">
        <span class="size-1.5 rounded-full bg-ink" aria-hidden="true" />
        {laPage.wildlifeKicker}
      </p>
    )
  }
  {laPage.wildlifeTitle && <h2 class="h2 max-w-[640px] text-h2">{laPage.wildlifeTitle}</h2>}
  {laPage.wildlifeIntro && <p class="mt-4 max-w-[560px] text-ink/64 leading-[1.6]">{laPage.wildlifeIntro}</p>}

  {
    species.length > 0 && (
      <div class="mt-12">
        <ImageCards
          client:visible
          closeLabel="Close"
          items={species.map((s) => ({
            name: s.name,
            meta: [s.season, s.place].filter(Boolean).join(" · "),
            text: s.note ?? undefined,
            src: s.image ?? "",
            alt: s.imageAlt ?? s.name,
          }))}
        />
      </div>
    )
  }

  {
    laPage.wildlifeFootnote && (
      <p class="mt-12 max-w-[62ch] text-[.85rem] text-ink/64">{laPage.wildlifeFootnote}</p>
    )
  }
</section>

<section class="relative mx-auto max-w-site py-section px-5 lg:px-pad">
  {
    laPage.destinationsKicker && (
      <p class="mb-[1.1rem] flex items-center gap-[.6rem] font-mono text-[.76rem] tracking-[.14em] text-ink/64 uppercase">
        <span class="size-1.5 rounded-full bg-ink" aria-hidden="true" />
        {laPage.destinationsKicker}
      </p>
    )
  }
  {laPage.destinationsTitle && <h2 class="h2 max-w-[600px] text-h2">{laPage.destinationsTitle}</h2>}

  {
    places.length > 0 && (
      <div class="mt-12">
        <ImageCards
          client:visible
          closeLabel="Close"
          items={places.map((p) => ({
            name: p.name,
            text: p.description ?? undefined,
            src: p.image ?? "",
            alt: p.imageAlt ?? p.name,
          }))}
        />
      </div>
    )
  }
</section>

<section class="relative mx-auto max-w-site px-5 py-section text-center lg:px-pad">
  {laPage.ctaTitle && <h2 class="mx-auto max-w-[620px] text-h2">{laPage.ctaTitle}</h2>}
  {
    laPage.ctaLabel && laPage.ctaHref && (
      <div class="mt-8">
        <Button href={laPage.ctaHref} variant="primary" context="default">
          {laPage.ctaLabel}
        </Button>
      </div>
    )
  }
</section>
