---
/**
 * The COMPLETE crew card: photo with the quote on it, name, role tags, the
 * scrollable About text (with "Keep reading" revealing History and Why), then
 * a footer with skills, languages, certificates and years of experience.
 * Built from the client's "Ficha completa" mockup.
 *
 * One component, two homes: the modal opened from the home slider's summary
 * card (CrewSummaryCard.astro -> CrewModal.tsx) and the grid on the
 * Passionate Sea People page (CrewPage.astro).
 *
 * The About text scrolls inside a fixed-height area (as in the mockup). Its
 * bottom edge fades out (a mask over the last 1.75rem, inside the padding, so
 * text that fits is untouched) because overlay scrollbars are invisible until
 * used — without the fade, a cut-off last line reads as a bug, not as "scroll".
 *
 * "Keep reading" is a native <details>, not JS state: it works with no
 * script, keeps its open state without a framework, and is announced
 * correctly by screen readers. It only renders when History or Why exist.
 *
 * Every field is click-to-edit (data-tina-field). Fields that are empty on a
 * member simply don't render — a half-filled record shows a smaller card,
 * not empty boxes.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import { clean, paragraphs, yearsText, type CrewLabels, type CrewMember } from "../lib/crew";

interface Props {
  member: NonNullable<CrewMember>;
  labels: CrewLabels;
  /** A shorter photo, so the whole card fits in the modal without scrolling the page. */
  compact?: boolean;
  class?: string;
}

const { member, labels, compact = false, class: className = "" } = Astro.props;

const roles = clean(member.roles);
const skills = clean(member.skills);
const certificates = clean(member.certificates);
const languages = (member.languages ?? []).filter((l): l is NonNullable<typeof l> => !!l?.language);
const about = paragraphs(member.about);
const history = paragraphs(member.history);
const why = paragraphs(member.why);
const hasMore = history.length + why.length > 0;
const years = member.yearsOfExperience;
const showFooter = skills.length + languages.length + certificates.length > 0 || years != null;
---

<article class:list={["crew-full flex h-full flex-col overflow-hidden rounded-lg border border-ink/14 bg-white", className]}>
  <div class:list={["relative flex-none overflow-hidden bg-ink", compact ? "aspect-[4/3]" : "aspect-[11/10]"]}>
    {
      member.image && (
        <img
          src={member.image}
          alt={member.imageAlt ?? ""}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover object-top"
          data-tina-field={tinaField(member, "image")}
        />
      )
    }
    {
      member.joiningTag && (
        <span
          class="absolute top-4 left-4 z-[2] rounded-sm bg-ink px-[.7rem] py-[.35rem] font-mono text-[.58rem] tracking-[.1em] text-white uppercase"
          data-tina-field={tinaField(member, "joiningTag")}
        >
          {member.joiningTag}
        </span>
      )
    }
    {
      member.quote && (
        <>
          <div class="absolute inset-0 bg-linear-to-b from-transparent via-ink/10 via-45% to-ink/85" aria-hidden="true" />
          <blockquote
            class="absolute inset-x-0 bottom-0 p-6 font-serif text-[clamp(1.15rem,2.4vw,1.45rem)] leading-[1.25] text-white italic"
            data-tina-field={tinaField(member, "quote")}
          >
            “{member.quote}”
          </blockquote>
        </>
      )
    }
  </div>

  <div class="flex-none px-6 pt-6 pb-4">
    <h3 class="font-display text-[1.6rem]" data-tina-field={tinaField(member, "name")}>{member.name}</h3>
    {
      roles.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2" data-tina-field={tinaField(member, "roles")}>
          {roles.map((role) => (
            <li class="rounded-sm border border-ink/40 px-3 py-1 font-mono text-[.66rem] tracking-[.1em] text-ink uppercase">
              {role}
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {
    about.length > 0 && (
      <div class="crew-full-text max-h-[14rem] min-h-[7rem] flex-1 overflow-y-auto border-t border-ink/8 px-6 pt-5 pb-8 text-[.94rem] leading-[1.7] text-ink/80 [mask-image:linear-gradient(to_bottom,#000_calc(100%-1.75rem),transparent)]">
        <div class="space-y-3" data-tina-field={tinaField(member, "about")}>
          {about.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        {hasMore && (
          <details class="mt-4 [&[open]>summary]:mb-4">
            <summary class="cursor-pointer list-none text-[.88rem] font-medium text-ink underline-offset-4 hover:underline [&::-webkit-details-marker]:hidden">
              {labels.readMoreLabel}
            </summary>
            <div class="space-y-5">
              {history.length > 0 && (
                <div data-tina-field={tinaField(member, "history")}>
                  {labels.historyLabel && (
                    <h4 class="mb-2 font-mono text-[.62rem] tracking-[.16em] text-ink/52 uppercase">{labels.historyLabel}</h4>
                  )}
                  <div class="space-y-3">
                    {history.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                </div>
              )}
              {why.length > 0 && (
                <div data-tina-field={tinaField(member, "why")}>
                  {labels.whyLabel && (
                    <h4 class="mb-2 font-mono text-[.62rem] tracking-[.16em] text-ink/52 uppercase">{labels.whyLabel}</h4>
                  )}
                  <div class="space-y-3">
                    {why.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </details>
        )}
      </div>
    )
  }

  {
    showFooter && (
      <div class="flex-none border-t border-ink/8 bg-surface px-6 py-5">
        {skills.length > 0 && (
          <ul class="flex flex-wrap gap-2" data-tina-field={tinaField(member, "skills")}>
            {skills.map((skill) => (
              <li class="rounded-sm bg-white px-[.65rem] py-[.3rem] font-mono text-[.62rem] tracking-[.1em] text-ink/74 uppercase">
                {skill}
              </li>
            ))}
          </ul>
        )}
        {(languages.length > 0 || certificates.length > 0) && (
          <div class:list={["grid grid-cols-[1fr_auto] gap-x-5 text-[.86rem] leading-[1.7] text-ink", skills.length > 0 && "mt-4"]}>
            <ul data-tina-field={tinaField(member, "languages")}>
              {languages.map((l) => (
                <li>
                  {l.flag && <span aria-hidden="true">{l.flag} </span>}
                  {l.language}
                  {l.level && <span class="text-ink/52"> ({l.level})</span>}
                </li>
              ))}
            </ul>
            <ul class="text-right" data-tina-field={tinaField(member, "certificates")}>
              {certificates.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </div>
        )}
        {years != null && (
          <p
            class:list={["border-t border-ink/14 pt-3 text-[.78rem] text-ink/52", (skills.length > 0 || languages.length > 0 || certificates.length > 0) && "mt-4"]}
            data-tina-field={tinaField(member, "yearsOfExperience")}
          >
            {yearsText(years, labels)}
          </p>
        )}
      </div>
    )
  }
</article>
