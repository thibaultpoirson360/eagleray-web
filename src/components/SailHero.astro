---
/**
 * Hero of Sail with Us: two photos side by side, same size, with a thin
 * off-white gap (water on the left, a long lunch on deck on the right). The
 * intro sits under the photos in two columns (title and text on the left, a
 * small note and link on the right), so nothing crowds the header. On a phone the photos stack and the text follows.
 * Keeps BaseLayout's transparent header. Tina markers come via `fields`.
 */
import Button from "./ui/Button.astro";

interface Props {
  title: string;
  kicker?: string | null;
  lede?: string | null;
  introTitle?: string | null;
  intro?: string | null;
  images: { src?: string | null; alt?: string | null; field?: string }[];
  cta?: { label: string; href: string } | null;
  link?: { label: string; href: string } | null;
  fields?: { title?: string; kicker?: string; lede?: string; introTitle?: string; intro?: string; cta?: string; link?: string };
}

const { title, kicker, lede, introTitle, intro: introText, images, cta, link, fields = {} } = Astro.props;
const intro = introText?.split(/\n\s*\n|\n/).filter(Boolean) ?? [];
---

<section class="bg-surface">
  <div class="relative grid gap-0.5 bg-surface md:h-[46vh] md:min-h-[22rem] md:grid-cols-2">
    {
      images.slice(0, 1).map((image) => (
        <div class="relative aspect-[4/3] bg-ink md:aspect-auto">
          {image.src && <img src={image.src} alt={image.alt ?? ""} loading="eager" decoding="async" class="absolute inset-0 h-full w-full object-cover" data-tina-field={image.field} />}
        </div>
      ))
    }
    <div class="pointer-events-none absolute inset-0 z-[1] hidden bg-ink/30 md:block"></div>
    {/* The headline: between the two stacked photos on a phone, centred over the seam between them from md up. */}
    <div class="px-5 py-14 text-center text-ink md:pointer-events-none md:absolute md:inset-0 md:z-[2] md:flex md:items-center md:justify-center md:py-0 md:text-white">
      <div class="mx-auto max-w-[40rem]">
        {kicker && <p class="mb-6 font-mono text-[.7rem] tracking-[.2em] uppercase opacity-70" data-tina-field={fields.kicker}>{kicker}</p>}
        <h1 class="font-display text-quote-lead leading-[1.5] font-normal whitespace-pre-line md:pointer-events-auto" data-tina-field={fields.title}>{title}</h1>
      </div>
    </div>
    {
      images.slice(1, 2).map((image) => (
        <div class="relative aspect-[4/3] bg-ink md:aspect-auto">
          {image.src && <img src={image.src} alt={image.alt ?? ""} loading="eager" decoding="async" class="absolute inset-0 h-full w-full object-cover" data-tina-field={image.field} />}
        </div>
      ))
    }
  </div>
  <div class="px-5 pt-[calc(var(--spacing-section)*.9)] pb-[calc(var(--spacing-section)*1.2)] lg:px-[calc(var(--spacing-pad)+var(--rail))]">
    <div class="mx-auto grid max-w-[64rem] gap-10 md:grid-cols-[1.5fr_1fr] md:gap-16">
      <div>
        {introTitle && <h2 class="mb-6 text-quote-lead leading-[1.35] font-normal" data-tina-field={fields.introTitle}>{introTitle}</h2>}
        {intro.map((paragraph) => <p class="max-w-[52ch] text-[.95rem] leading-[1.9] text-ink/64" data-tina-field={fields.intro}>{paragraph}</p>)}
      </div>
      <div class="md:pt-2">
        {lede && <p class="text-[.82rem] leading-[1.8] text-ink/64" data-tina-field={fields.lede}>{lede}</p>}
        {
          cta && (
            <div class="mt-8">
              <Button href={cta.href} variant="primary" context="default" size="sm" data-tina-field={fields.cta}>
                {cta.label}
              </Button>
            </div>
          )
        }
        {
          link && (
            <p class="mt-5 text-[.82rem] leading-[1.8]">
              <a href={link.href} class="text-ink/56 underline underline-offset-[6px] transition-colors hover:text-ink" data-tina-field={fields.link}>{link.label}</a>
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>
