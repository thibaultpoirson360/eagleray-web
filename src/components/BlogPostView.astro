---
/**
 * `/<locale>/blog/<slug>` — one Journal post. Built from the same mockup as
 * BlogListing.astro — see that file's and tina/collections/blog.ts's
 * comments for the full context.
 *
 * `body`'s rich-text rendering registers three overrides
 * (src/components/richtext/*.astro) so a post's paragraphs, a `>`
 * blockquote, and a captioned image match the mockup's paragraph/
 * pull-quote/mid-article-image treatment — see those files' own comments.
 */
import TinaMarkdown from "@tinacms/astro/TinaMarkdown.astro";
import { tinaField } from "@tinacms/astro/tina-field";
import BodyParagraph from "./richtext/BodyParagraph.astro";
import BodyQuote from "./richtext/BodyQuote.astro";
import BodyImage from "./richtext/BodyImage.astro";
import { localePath, type Locale } from "../i18n/config";
import type { BlogPostQuery, BlogPostConnectionQuery, BlogSectionQuery } from "../../tina/__generated__/types";

type Post = NonNullable<NonNullable<BlogPostConnectionQuery["blogPostConnection"]["edges"]>[number]>["node"];

interface Props {
  post: BlogPostQuery["blogPost"];
  related: NonNullable<Post>[];
  /** The listing's own labels ("← All Stories", "More from the Journal"…) — same per-locale document. */
  blogSection: BlogSectionQuery["blogSection"];
  locale: Locale;
}

const { post, related, blogSection, locale } = Astro.props;

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString(locale, { month: "short", day: "numeric", year: "numeric" });
}

function postHref(p: { _sys: { filename: string } }): string {
  return localePath(locale, `blog/${p._sys.filename}/`);
}
---

<section class="relative mx-auto max-w-site border-t border-ink/8 py-section pr-pad pl-[calc(var(--spacing-pad)+var(--rail))]">
  <a href={localePath(locale, "blog/")} class="mb-10 block text-[13px] tracking-[.04em] text-ink/64 hover:text-ink" data-tina-field={tinaField(blogSection, "backLabel")}>{blogSection.backLabel}</a>

  <div class="text-[.72rem] tracking-[.1em] text-ink/64 uppercase">
    <span class="text-ink" data-tina-field={tinaField(post, "category")}>
      {post.category}
    </span>{" "}
    · {formatDate(post.date)} · {post.readTime}
  </div>
  <h1 class="mt-[18px] mb-5 max-w-[760px] font-display text-[clamp(28px,4.2vw,42px)]" data-tina-field={tinaField(post, "title")}>
    {post.title}
  </h1>
  {
    post.subtitle && (
      <p class="mb-8 max-w-[640px] text-lg text-ink/64" data-tina-field={tinaField(post, "subtitle")}>
        {post.subtitle}
      </p>
    )
  }

  <div class="mb-11 flex items-center gap-[.9rem]">
    {post.authorAvatar && (
      <img
        src={post.authorAvatar}
        alt={post.author}
        class="size-[46px] flex-none rounded-full object-cover"
        data-tina-field={tinaField(post, "authorAvatar")}
      />
    )}
    <div>
      <div class="text-sm text-ink" data-tina-field={tinaField(post, "author")}>
        {post.author}
      </div>
      {post.authorRole && (
        <div class="text-[13px] text-ink/64" data-tina-field={tinaField(post, "authorRole")}>
          {post.authorRole}
        </div>
      )}
    </div>
  </div>

  {
    post.coverImage && (
      <div class="mb-12 aspect-video overflow-hidden rounded-lg">
        <img
          src={post.coverImage}
          alt={post.coverImageAlt ?? ""}
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover"
          data-tina-field={tinaField(post, "coverImage")}
        />
      </div>
    )
  }

  <div class="mx-auto max-w-[700px]" data-tina-field={tinaField(post, "body")}>
    <TinaMarkdown content={post.body} components={{ p: BodyParagraph, blockquote: BodyQuote, img: BodyImage }} />

    <div class="mt-16 flex items-center gap-4 border-t border-ink/14 pt-8">
      {post.authorAvatar && <img src={post.authorAvatar} alt={post.author} class="size-12 flex-none rounded-full object-cover" />}
      <div>
        <div class="font-display text-base text-ink">{post.author}</div>
        <div class="text-[13px] text-ink/64">
          <span data-tina-field={tinaField(post, "authorRole")}>{post.authorRole}</span>
          {blogSection.authorSuffix && <span data-tina-field={tinaField(blogSection, "authorSuffix")}>{" "}{blogSection.authorSuffix}</span>}
        </div>
      </div>
    </div>
  </div>

  {
    related.length > 0 && (
      <div class="mt-[4.5rem]">
        <h2 class="mb-7 text-[22px]" data-tina-field={tinaField(blogSection, "relatedHeading")}>{blogSection.relatedHeading}</h2>
        <div class="grid gap-8 [grid-template-columns:repeat(auto-fill,minmax(260px,1fr))]">
          {related.map((p) => (
            <a href={postHref(p)} class="block">
              <div class="relative aspect-[4/3] overflow-hidden rounded-lg">
                {p.coverImage && (
                  <img src={p.coverImage} alt={p.coverImageAlt ?? ""} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                )}
              </div>
              <div class="mt-4 text-xs text-ink/64">
                {p.author} · {formatDate(p.date)}
              </div>
              <h3 class="mt-2 text-lg">{p.title}</h3>
            </a>
          ))}
        </div>
      </div>
    )
  }
</section>
