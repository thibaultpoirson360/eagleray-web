---
/**
 * Hero — `<section class="hero" id="top">` in the source index.html
 * (lines 89-109), CSS at styles.css "8. HERO" (L853-1080).
 *
 * Rendered inside a neutral <TinaIsland> wrapper (see src/pages/en/index.astro
 * and src/pages/tina-island/[name].ts) rather than making the island's own
 * wrapper tag the <section> itself, because TinaIsland's wrapper prop only
 * supports {tag, className} — no `id`, and this section needs id="top" for
 * the nav's #top anchor.
 *
 * Not wired here (deliberately, see chat): the magnetic pointer-follow
 * effect on the primary CTA. That's main.js's initMagnetic(), page-chrome
 * JS shared by the whole site (scans the whole document for
 * [data-magnetic]), bootstrapped once when Nav/chrome is built — not
 * re-implemented per section. The markup below is already wired for it
 * (data-magnetic) and degrades to a plain link with none of it loaded.
 */
import Button from "./ui/Button.astro";
import { tinaField } from "@tinacms/astro/tina-field";
import type { HeroQuery } from "../../tina/__generated__/types";

interface Props {
  hero: HeroQuery["hero"];
}

const { hero } = Astro.props;
---

<section class="hero pl-(--rail) relative isolate flex min-h-svh items-end overflow-hidden" id="top">
  <div class="hero-bg absolute inset-0 z-[-3]">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={hero.background?.image ?? undefined}
      aria-hidden="true"
      class="motion-reduce:hidden absolute inset-0 h-full w-full object-cover object-[50%_42%] [transform:translateZ(0)] will-change-transform"
      data-tina-field={tinaField(hero, "background")}
    >
      {hero.background?.videoSrc && <source src={hero.background.videoSrc} type="video/mp4" />}
    </video>
    <img
      src={hero.background?.image ?? undefined}
      alt={hero.background?.imageAlt ?? ""}
      fetchpriority="high"
      loading="eager"
      decoding="sync"
      class="hidden motion-reduce:block motion-reduce:animate-none animate-hero-zoom absolute inset-0 h-full w-full origin-[50%_40%] object-cover object-[50%_42%]"
    />
    <div
      class="absolute inset-0 bg-linear-to-b from-ink/25 via-ink/42 via-45% to-ink/82"
    >
    </div>
  </div>

  <div class="hero-inner relative mx-auto w-full max-w-site pt-32 px-5 pb-hero-b text-white lg:px-pad">
    <p class="hero-meta mb-[1.4rem] inline-flex items-center gap-2 font-mono text-[.78rem] tracking-widest uppercase text-white/82">
      <span
        class="size-1.5 rounded-full bg-white animate-pulse-dot motion-reduce:animate-none"
        aria-hidden="true"
      ></span>
      <span data-tina-field={tinaField(hero, "metaLine")}>{hero.metaLine}</span>
    </p>
    <h1
      class="hero-title max-w-[20ch] font-display text-hero text-white"
      data-tina-field={tinaField(hero, "title")}
    >
      {hero.title}
    </h1>
    {
      hero.subtitle && (
        <p
          class="hero-sub mt-[1.3rem] max-w-[50ch] text-hero-sub text-white/86"
          data-tina-field={tinaField(hero, "subtitle")}
        >
          {hero.subtitle}
        </p>
      )
    }
    <div class="hero-actions mt-[2.3rem] flex flex-wrap gap-4">
      {
        hero.primaryCta && (
          <Button
            href={hero.primaryCta.href}
            variant="primary"
            context="hero"
            magnetic
            data-tina-field={tinaField(hero, "primaryCta")}
          >
            {hero.primaryCta.label}
          </Button>
        )
      }
      {
        hero.secondaryCta && (
          <Button
            href={hero.secondaryCta.href}
            variant="ghost"
            context="hero"
            data-tina-field={tinaField(hero, "secondaryCta")}
          >
            {hero.secondaryCta.label}
          </Button>
        )
      }
    </div>
  </div>

  <a
    class="scroll-cue absolute bottom-[1.6rem] left-1/2 h-9 w-[22px] -translate-x-1/2 rounded-full border border-white/45"
    href="#difference"
    aria-label={hero.scrollCueLabel ?? "Scroll to next section"}
  >
    <span
      class="absolute top-1.5 left-1/2 -ml-0.5 h-2 w-1 rounded-full bg-white animate-scroll-cue motion-reduce:animate-none"
    ></span>
  </a>
</section>
