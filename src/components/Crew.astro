---
/**
 * Crew — `<section class="section" id="crew">` in the source index.html
 * (lines 158-336), CSS at styles.css "15. CREW" (L1865-1987) plus the
 * shared boats-dots rules (L1784-1809, reused verbatim by the boats
 * slider too — see SliderDots.tsx) and the shared `.section`/
 * `.section-head` shell from Difference.
 *
 * The slider's card row is plain CSS scroll-snap (works with zero JS,
 * same as the source); only the dot-navigation control is Preact, per
 * CLAUDE.md's "sliders (boats, crew)... Preact." See SliderDots.tsx.
 *
 * The cards are now the summary card (CrewSummaryCard.astro: photo, quote,
 * name, role, "Meet <name> →"), which opens the complete card in a modal —
 * a deliberate redesign from the client's mockups, replacing the source's
 * wide photo-plus-bio cards. The complete cards live on the Passionate Sea
 * People page (CrewPage.astro).
 *
 * Two small, deliberate deviations from source, both flagged in chat:
 *  - `.crew-card-body { align-self: top }` is invalid CSS (does
 *    nothing) — not ported.
 *  - The CTA's wrapper used `.container`, which combined with `--rail`
 *    renders off-centre (audit §2c.6) — using a plain centred block
 *    instead, matching audit §6 item 13's suggested resolution.
 * Source content typos (missing spaces, a doubled period) in `intro`/
 * `rolesIntro` are preserved as-is, not silently corrected — see chat.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import Button from "./ui/Button.astro";
import SliderDots from "./SliderDots.tsx";
import CrewSummaryCard from "./CrewSummaryCard.astro";
import type { Locale } from "../i18n/config";
import type { CrewMember } from "../lib/crew";
import type { CrewSectionQuery } from "../../tina/__generated__/types";

interface Props {
  crewSection: CrewSectionQuery["crewSection"];
  members: NonNullable<CrewMember>[];
  locale: Locale;
}

const { crewSection, members, locale } = Astro.props;
const { cta } = crewSection;
---

<section
  class="section relative mx-auto max-w-site border-t border-ink/8 py-section pr-pad pl-[calc(var(--spacing-pad)+var(--rail))]"
  id="crew"
  data-depth-stop={crewSection.depth?.meters ?? undefined}
  data-depth-name={crewSection.depth?.name ?? undefined}
>
  <div class="section-head mb-section-head">
    <p
      class="kicker mb-[1.1rem] flex items-center gap-[.6rem] font-mono text-[.76rem] tracking-[.14em] text-ink/64 uppercase"
      data-reveal
    >
      {
        crewSection.kickerNumber && (
          <span class="text-ink" data-tina-field={tinaField(crewSection, "kickerNumber")}>
            {crewSection.kickerNumber}
          </span>
        )
      }
      <span data-tina-field={tinaField(crewSection, "kicker")}>{crewSection.kicker}</span>
    </p>
    <h2 class="h2 text-h2" data-reveal data-tina-field={tinaField(crewSection, "title")}>
      {crewSection.title}
      {
        crewSection.titleEmphasis && (
          <>
            <br />
            <em class="not-italic text-ink" data-tina-field={tinaField(crewSection, "titleEmphasis")}>
              {crewSection.titleEmphasis}
            </em>
          </>
        )
      }
    </h2>
    {
      crewSection.intro && (
        <p
          class="section-intro mt-[1.2rem] text-ink/74 opacity-[.92]"
          data-tina-field={tinaField(crewSection, "intro")}
        >
          {crewSection.intro}
        </p>
      )
    }
  </div>

  <div
    class="crew-slider reveal -mx-pad mt-[3.4rem] flex snap-x snap-mandatory gap-[1.6rem] overflow-x-auto px-pad pb-4 [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-crew-slider
  >
    {
      members.map((member) => <CrewSummaryCard member={member} labels={crewSection} locale={locale} />)
    }
  </div>

  <SliderDots
    client:visible
    sliderSelector="[data-crew-slider]"
    cardSelector=".crew-card"
    count={members.length}
    labelPrefix={crewSection.dotsLabel ?? "Go to crew member"}
  />

  {
    crewSection.rolesIntro && (
      <p
        class="section-intro mt-[1.2rem] text-ink/74 opacity-[.92]"
        data-tina-field={tinaField(crewSection, "rolesIntro")}
      >
        {crewSection.rolesIntro}
      </p>
    )
  }

  {
    cta && (
      <p class="mt-10 text-center" data-reveal>
        <Button href={cta.href} variant="primary" context="default" data-tina-field={tinaField(crewSection, "cta")}>
          {cta.label}
        </Button>
      </p>
    )
  }
</section>
