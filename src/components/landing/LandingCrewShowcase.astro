---
/**
 * `crewShowcase` landing block: a big heading and text on one side and, on the
 * other, a slider of crew cards (the same cards as the homepage crew slider,
 * each opening the full profile), with a note under the slider. The members
 * are listed by file name in the editor and come from the page's language.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import CrewSummaryCard from "../CrewSummaryCard.astro";
import SliderDots from "../SliderDots.tsx";
import ImageSlider from "../ImageSlider.tsx";
import { loadCrew, loadCrewSection } from "../../lib/content";
import type { LandingPageBlocksParent } from "./blockTypes";
import type { Locale } from "../../i18n/config";

interface Props {
  block: any;
  landingPage: LandingPageBlocksParent;
  index: number;
  locale: Locale;
}

const { block, landingPage, index, locale } = Astro.props;
const [{ members }, sectionResult] = await Promise.all([loadCrew(locale), loadCrewSection(locale)]);
const wanted = ((block.members ?? []) as (string | null)[]).map((m) => String(m ?? "").trim()).filter(Boolean);
const chosen = wanted.flatMap((name) => members.filter((m) => m._sys.filename === name));
const photos = ((block.photos ?? []) as any[]).filter((x) => x?.image).map((x) => ({ src: x.image as string, alt: (x.alt as string) || block.title }));
const showPhotos = photos.length > 0 || (chosen.length === 0 && !!block.photoNote);
---

<section
  class="relative mx-auto max-w-site border-t border-ink/8 px-pad py-[calc(var(--spacing-section)*1.5)]"
  data-tina-field={tinaField(landingPage, "blocks", index)}
>
  <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <div class="lg:sticky lg:top-28">
      <h2 class="font-display text-hero text-ink" data-tina-field={tinaField(block, "title")}>
        {block.title}
        {block.titleEmphasis && (
          <>
            <br />
            <em class="not-italic text-ink/50" data-tina-field={tinaField(block, "titleEmphasis")}>{block.titleEmphasis}</em>
          </>
        )}
      </h2>
      {block.blurb && <p class="mt-6 max-w-[48ch] text-[.95rem] leading-[1.7] text-ink/74" data-tina-field={tinaField(block, "blurb")}>{block.blurb}</p>}
      {block.linkLabel && block.linkHref && (
        <p class="mt-5">
          <a href={block.linkHref} class="text-[.95rem] font-medium text-ink underline underline-offset-4">{block.linkLabel}</a>
        </p>
      )}
    </div>

    <div class="min-w-0">
      {
        showPhotos ? (
          <div class="relative aspect-[4/3] overflow-hidden rounded-lg border border-ink/14 bg-white" data-tina-field={tinaField(block, "photos")}>
            {photos.length > 0 ? (
              <ImageSlider client:visible photos={photos} previousLabel="Previous photo" nextLabel="Next photo" dotLabel="Photo" dotsAt="bottom" fit="contain" tone="light" className="h-full w-full" />
            ) : (
              <p class="absolute inset-0 flex items-center justify-center px-8 text-center font-mono text-[.76rem] tracking-[.14em] text-ink/50">{block.photoNote}</p>
            )}
          </div>
        ) : (
          <>
            <div class="-mx-pad flex snap-x snap-mandatory gap-5 overflow-x-auto px-pad pb-4 [-webkit-overflow-scrolling:touch] [scrollbar-width:none] lg:mx-0 lg:px-0 [&::-webkit-scrollbar]:hidden" data-crew-showcase tabindex="0" role="group" aria-label={block.title}>
              {chosen.map((member) => <CrewSummaryCard member={member} labels={sectionResult.data.crewSection} locale={locale} />)}
            </div>
            <SliderDots client:visible sliderSelector="[data-crew-showcase]" cardSelector=".crew-card" count={chosen.length} labelPrefix={sectionResult.data.crewSection.dotsLabel ?? "Go to crew member"} />
          </>
        )
      }
      {block.note && <p class="mt-6 max-w-[60ch] text-[.92rem] leading-[1.65] text-ink/64" data-tina-field={tinaField(block, "note")}>{block.note}</p>}
    </div>
  </div>
</section>
