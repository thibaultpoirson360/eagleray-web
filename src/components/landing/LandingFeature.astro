---
/**
 * `feature` landing block: one activity with a big photo (or a slider of
 * photos), a short text, and a "more about it" that stays closed until the
 * visitor opens it, so the page does not get long.
 */
import TinaMarkdown from "@tinacms/astro/TinaMarkdown.astro";
import { tinaField } from "@tinacms/astro/tina-field";
import ImageSlider from "../ImageSlider.tsx";
import Button from "../ui/Button.astro";
import { localePath, type Locale } from "../../i18n/config";
import BodyParagraph from "../richtext/BodyParagraph.astro";
import type { LandingPageBlocksParent } from "./blockTypes";

interface Props {
  block: any;
  landingPage: LandingPageBlocksParent;
  index: number;
  locale: Locale;
}

const { block, landingPage, index, locale } = Astro.props;
const contactHref = localePath(locale, "contact/") + (block.buttonMessage ? `?message=${encodeURIComponent(block.buttonMessage)}` : "");
const photos = ((block.photos ?? []) as any[]).filter((p) => p?.image).map((p) => ({ src: p.image as string, alt: (p.alt as string) || block.title, video: (p.video as string) || undefined }));
---

<section
  class="relative mx-auto max-w-site border-t border-ink/8 px-pad py-[calc(var(--spacing-section)*1.5)]"
  data-tina-field={tinaField(landingPage, "blocks", index)}
>
  <div class="relative aspect-[4/3] overflow-hidden rounded-lg bg-ink md:aspect-[21/9]" data-tina-field={tinaField(block, "photos")}>
    {
      photos.length > 0 ? (
        <ImageSlider client:visible photos={photos} previousLabel="Previous photo" nextLabel="Next photo" dotLabel="Photo" dotsAt="bottom" className="h-full w-full" />
      ) : (
        <p class="absolute inset-0 flex items-center justify-center px-8 text-center font-mono text-[.76rem] tracking-[.14em] text-white/60">{block.photoNote}</p>
      )
    }
  </div>

  <div class="mx-auto mt-10 max-w-[760px]">
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-3">
      <h2 class="h2 text-h2" data-tina-field={tinaField(block, "title")}>{block.title}</h2>
      {block.tag && <p class="rounded-sm border border-ink/40 px-3 py-1 font-display text-[.85rem] font-normal text-ink/74" data-tina-field={tinaField(block, "tag")}>{block.tag}</p>}
    </div>
    {block.lede && <p class="mt-3 font-serif text-quote-lead text-ink/64 italic" data-tina-field={tinaField(block, "lede")}>{block.lede}</p>}
    {block.blurb && <p class="mt-5 max-w-[60ch] text-[.95rem] leading-[1.7] text-ink/78" data-tina-field={tinaField(block, "blurb")}>{block.blurb}</p>}

    {
      block.more && block.moreLabel && (
        <details class="group/more mt-6 border-t border-ink/14 pt-5">
          <summary class="flex cursor-pointer list-none items-center gap-2 text-[.95rem] font-medium text-ink underline-offset-4 hover:underline [&::-webkit-details-marker]:hidden">
            <span data-tina-field={tinaField(block, "moreLabel")}>{block.moreLabel}</span>
            <span aria-hidden="true" class="transition-transform duration-300 group-open/more:rotate-45 motion-reduce:transition-none">+</span>
          </summary>
          <div class="mt-5 text-ink/78 [&_li]:mb-1.5 [&_strong]:mt-5 [&_strong]:block [&_strong]:font-display [&_strong]:text-[1.05rem] [&_strong]:font-medium [&_strong]:text-ink [&_ul]:mt-2 [&_ul]:list-disc [&_ul]:pl-5" data-tina-field={tinaField(block, "more")}>
            <TinaMarkdown content={block.more} components={{ p: BodyParagraph }} />
          </div>
          {block.buttonLabel && (
            <div class="mt-6">
              <Button href={contactHref} variant="primary" context="default" size="sm" data-tina-field={tinaField(block, "buttonLabel")}>
                {block.buttonLabel}
              </Button>
            </div>
          )}
        </details>
      )
    }
  </div>
</section>
