---
/**
 * `moguProposal` landing block — thin wrapper around the standalone
 * src/components/MoguProposal.astro, adding the same section shell every
 * other block uses plus the block-level `data-tina-field` marker.
 */
import MoguProposal from "../MoguProposal.astro";
import { tinaField } from "@tinacms/astro/tina-field";
import { moguForLocale } from "../../lib/mogu";
import type { Locale } from "../../i18n/config";
import type { MoguProposalBlock, LandingPageBlocksParent } from "./blockTypes";

interface Props {
  block: MoguProposalBlock;
  landingPage: LandingPageBlocksParent;
  index: number;
  locale: Locale;
}

const { block, landingPage, index, locale } = Astro.props;
---

<section
  class="relative mx-auto max-w-site border-t border-ink/8 px-pad py-[calc(var(--spacing-section)*1.5)]"
  data-tina-field={tinaField(landingPage, "blocks", index)}
>
  <div data-tina-field={tinaField(block, "tripSlug")}>
    <MoguProposal
      tripSlug={moguForLocale(locale, block.tripSlug)}
      height={block.height ?? undefined}
      title={block.iframeTitle ?? undefined}
      hideLogo={block.hideLogo ?? false}
      hideTitle={block.hideTitle ?? false}
    />
  </div>
</section>
