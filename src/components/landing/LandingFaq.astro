---
/**
 * `faq` landing block: questions that open and close. Native <details>, so it
 * works with the keyboard and without JavaScript, and every answer is in the
 * page for search engines.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import type { LandingPageBlocksParent } from "./blockTypes";

interface Props {
  block: any;
  landingPage: LandingPageBlocksParent;
  index: number;
}

const { block, landingPage, index } = Astro.props;
const questions = ((block.questions ?? []) as any[]).flatMap((q, i) => (q?.question ? [{ q, i }] : []));
---

<section
  class="relative mx-auto max-w-site border-t border-ink/8 px-pad py-section"
  data-tina-field={tinaField(landingPage, "blocks", index)}
>
  <div class="mx-auto max-w-[760px]">
    <h2 class="h2 mb-section-head text-h2" data-tina-field={tinaField(block, "title")}>{block.title}</h2>
    <div class="divide-y divide-ink/14 border-y border-ink/14">
      {
        questions.map(({ q, i }) => (
          <details class="group/faq py-5" data-tina-field={tinaField(block, "questions", i)}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[1.15rem] text-ink [&::-webkit-details-marker]:hidden">
              <span>{q.question}</span>
              <span aria-hidden="true" class="mt-1 flex-none text-ink/64 transition-transform duration-300 group-open/faq:rotate-45 motion-reduce:transition-none">+</span>
            </summary>
            {q.answer && (
              <div class="mt-3 max-w-[62ch] space-y-3 leading-[1.65] text-ink/74">
                {String(q.answer)
                  .split(/\n\s*\n/)
                  .map((p) => (
                    <p>{p}</p>
                  ))}
              </div>
            )}
          </details>
        ))
      }
    </div>
  </div>
</section>
