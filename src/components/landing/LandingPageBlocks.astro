---
/**
 * Dispatches each `landingPage.blocks` item to its renderer by
 * `__typename` — the same union-discrimination pattern Nav.astro uses for
 * `NavigationLinksLink` vs `NavigationLinksDropdown` (tina/collections/
 * navigation.ts). Tina names a stored block's generated GraphQL type
 * `<Collection><Field><Template>` in PascalCase, so the five templates on
 * landingPage.blocks (tina/collections/landingPage.ts) become:
 *   hero          -> LandingPageBlocksHero
 *   richText      -> LandingPageBlocksRichText
 *   imageGallery  -> LandingPageBlocksImageGallery
 *   cta           -> LandingPageBlocksCta
 *   moguProposal  -> LandingPageBlocksMoguProposal
 * Confirmed against the generated tina/__generated__/types.ts after
 * `tinacms build` (see blockTypes.ts).
 */
import LandingHero from "./LandingHero.astro";
import LandingRichText from "./LandingRichText.astro";
import LandingImageGallery from "./LandingImageGallery.astro";
import LandingCta from "./LandingCta.astro";
import LandingMoguProposal from "./LandingMoguProposal.astro";
import LandingFunnel from "./LandingFunnel.astro";
import LandingMemberProfile from "./LandingMemberProfile.astro";
import LandingDepartures from "./LandingDepartures.astro";
import LandingIncludes from "./LandingIncludes.astro";
import LandingTimeline from "./LandingTimeline.astro";
import LandingFaq from "./LandingFaq.astro";
import LandingActions from "./LandingActions.astro";
import LandingCinematicRoute from "./LandingCinematicRoute.astro";
import LandingTripBoats from "./LandingTripBoats.astro";
import LandingFeature from "./LandingFeature.astro";
import LandingCrewShowcase from "./LandingCrewShowcase.astro";
import LandingEventIntro from "./LandingEventIntro.astro";
import LandingEventEvening from "./LandingEventEvening.astro";
import LandingEventPhotoStrip from "./LandingEventPhotoStrip.astro";
import LandingEventPeople from "./LandingEventPeople.astro";
import LandingEventCards from "./LandingEventCards.astro";
import LandingEventRsvp from "./LandingEventRsvp.astro";
import LandingEventPlace from "./LandingEventPlace.astro";
import MoguProposalHero from "../MoguProposalHero.astro";
import type { LandingPageBlocksParent } from "./blockTypes";
import type { Locale } from "../../i18n/config";

interface Props {
  landingPage: LandingPageBlocksParent;
  /** Needed so a block's `#customize` link can point at that language's homepage. */
  locale: Locale;
}

const { landingPage, locale } = Astro.props;
---

{
  // Matched by block kind, not by the full GraphQL type name: the same block
  // definitions are used by landing pages (LandingPageBlocks…) and nav pages
  // (NavPagesBlocks…), so the generated type name differs by document.
  (landingPage.blocks ?? []).map((raw: any, index: number) => {
    if (!raw) return null;
    const kind = raw.__typename.replace(/^(LandingPage|NavPages)Blocks/, "");
    const block = raw as any;
    return (
      <>
        {kind === "Hero" && <LandingHero block={block} landingPage={landingPage} index={index} locale={locale} />}
        {kind === "RichText" && <LandingRichText block={block} landingPage={landingPage} index={index} />}
        {kind === "ImageGallery" && (
          <LandingImageGallery block={block} landingPage={landingPage} index={index} locale={locale} />
        )}
        {kind === "Cta" && <LandingCta block={block} landingPage={landingPage} index={index} locale={locale} />}
        {kind === "MemberProfile" && <LandingMemberProfile block={block} landingPage={landingPage} index={index} locale={locale} />}
        {kind === "Funnel" && <LandingFunnel locale={locale} />}
        {kind === "Departures" && <LandingDepartures block={block} landingPage={landingPage} index={index} locale={locale} />}
        {kind === "Includes" && <LandingIncludes block={block} landingPage={landingPage} index={index} />}
        {kind === "Timeline" && <LandingTimeline block={block} landingPage={landingPage} index={index} />}
        {kind === "Feature" && <LandingFeature block={block} landingPage={landingPage} index={index} locale={locale} />}
        {kind === "CrewShowcase" && <LandingCrewShowcase block={block} landingPage={landingPage} index={index} locale={locale} />}
        {kind === "TripBoats" && <LandingTripBoats block={block} landingPage={landingPage} index={index} locale={locale} />}
        {kind === "CinematicRoute" && <LandingCinematicRoute block={block} landingPage={landingPage} index={index} />}
        {kind === "Actions" && <LandingActions block={block} landingPage={landingPage} index={index} locale={locale} />}
        {kind === "Faq" && <LandingFaq block={block} landingPage={landingPage} index={index} />}
        {kind === "EventIntro" && <LandingEventIntro block={block} landingPage={landingPage} index={index} />}
        {kind === "EventEvening" && <LandingEventEvening block={block} landingPage={landingPage} index={index} />}
        {kind === "EventPhotoStrip" && <LandingEventPhotoStrip block={block} landingPage={landingPage} index={index} />}
        {kind === "EventPeople" && <LandingEventPeople block={block} landingPage={landingPage} index={index} />}
        {kind === "EventCards" && <LandingEventCards block={block} landingPage={landingPage} index={index} />}
        {kind === "EventRsvp" && <LandingEventRsvp block={block} landingPage={landingPage} index={index} />}
        {kind === "EventPlace" && <LandingEventPlace block={block} landingPage={landingPage} index={index} />}
        {kind === "MoguProposal" && <LandingMoguProposal block={block} landingPage={landingPage} index={index} locale={locale} />}
        {kind === "MoguHero" && <MoguProposalHero tripSlug={block.tripSlug} hideLogo={block.hideLogo ?? false} hideTitle={block.hideTitle ?? false} title={block.iframeTitle ?? undefined} />}
      </>
    );
  })
}
