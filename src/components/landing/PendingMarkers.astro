---
/**
 * Safety net: any "[PENDIENTE: ...]" or "[PENDIENTE]" written in a page's text
 * is removed from the public page, so a placeholder is never shown to visitors.
 */
const html = await Astro.slots.render("default");
// Only text between tags is touched, never a tag or an attribute (an interactive
// block keeps its data in an attribute, and that must stay exactly as it is).
const marked = html.replace(/(<[^>]*>)|(\[PENDIENTE[^\]<]*\])/g, (all, tag, marker) =>
  tag ? tag : ""
);
---

<Fragment set:html={marked} />
