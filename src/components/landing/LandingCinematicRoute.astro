---
/**
 * `cinematicRoute` landing block: a route told in full-screen scenes. As the
 * visitor scrolls, the background photo, the title and the text change, and a
 * map in a side panel draws the leg of the trip being told. Tabs switch between
 * trips. The sea routes are worked out here, at build time, so the map never
 * draws a route across land. Everything is read from the block's own fields;
 * for people who cannot or do not use the scroll effect, the same steps are
 * written out as a plain list.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import CinematicRoute from "../CinematicRoute.tsx";
import { LAND, MAP, project } from "../../lib/espiritu-santo-map";
import { seaPath, smoothPath } from "../../lib/route-path";
import type { LandingPageBlocksParent } from "./blockTypes";

interface Props {
  block: any;
  landingPage: LandingPageBlocksParent;
  index: number;
}

const { block, landingPage, index } = Astro.props;
const places: Record<string, { name: string; sub: string; xy: [number, number] }> = {};
for (const p of (block.places ?? []) as any[]) {
  if (p?.key && typeof p.lat === "number" && typeof p.lon === "number") places[p.key] = { name: p.name ?? p.key, sub: p.sub ?? "", xy: project(p.lat, p.lon) };
}

const trips = ((block.trips ?? []) as any[]).flatMap((trip) => {
  const beats = ((trip?.beats ?? []) as any[]).flatMap((beat) => {
    const keys = [beat.from, ...((beat.via ?? []) as string[]), beat.to].filter((k) => k && places[k]);
    if (keys.length < 2) return [];
    const pts: [number, number][] = [];
    for (let i = 0; i < keys.length - 1; i++) {
      const leg = seaPath(places[keys[i]].xy, places[keys[i + 1]].xy);
      pts.push(...(i === 0 ? leg : leg.slice(1)));
    }
    return [
      {
        label: beat.label ?? "",
        title: beat.title,
        text: beat.text ?? "",
        night: beat.night ?? "",
        image: beat.image ?? "",
        imageAlt: beat.imageAlt ?? "",
        imageNote: beat.imageNote ?? "",
        from: beat.from as string,
        to: beat.to as string,
        path: smoothPath(pts),
      },
    ];
  });
  if (beats.length === 0) return [];
  // The stops of the trip, numbered in the order they are visited.
  const order: string[] = [];
  for (const b of beats) for (const k of [b.from, b.to]) if (!order.includes(k)) order.push(k);
  const stops = order.map((k, i) => ({ key: k, n: i + 1, name: places[k].name, sub: places[k].sub, x: places[k].xy[0], y: places[k].xy[1] }));
  return [{ tab: trip.tab as string, beats, stops }];
});

// One view box for all trips: every place plus some room around them.
const xs = Object.values(places).map((p) => p.xy[0]);
const ys = Object.values(places).map((p) => p.xy[1]);
const pad = 40;
const vb = trips.length
  ? (() => {
      let x0 = Math.min(...xs) - pad;
      let x1 = Math.max(...xs) + pad;
      const y0 = Math.min(...ys) - pad;
      const y1 = Math.max(...ys) + pad;
      const w = Math.max(x1 - x0, (y1 - y0) * 0.34);
      const cx = (x0 + x1) / 2;
      x0 = cx - w / 2;
      x1 = cx + w / 2;
      return [Math.round(x0), Math.round(y0), Math.round(x1 - x0), Math.round(y1 - y0)];
    })()
  : [0, 0, 1, 1];
---

{
  trips.length > 0 && (
    <section class="relative border-t border-ink/8" data-tina-field={tinaField(landingPage, "blocks", index)}>
      <div class="mx-auto max-w-site px-pad py-[calc(var(--spacing-section)*1.5)]">
        <h2 class="h2 text-h2" data-tina-field={tinaField(block, "title")}>{block.title}</h2>
        {block.intro && <p class="mt-[1.2rem] max-w-[58ch] text-[.95rem] text-ink/74" data-tina-field={tinaField(block, "intro")}>{block.intro}</p>}
      </div>

      <CinematicRoute client:visible trips={trips} land={LAND} viewBox={vb} mapNote={block.mapNote ?? ""} heading={block.title} />

      <noscript>
        <div class="mx-auto max-w-site px-pad pb-[calc(var(--spacing-section)*1.5)]">
          {trips.map((trip) => (
            <div class="mb-8">
              <h3 class="font-display text-[1.3rem]">{trip.tab}</h3>
              <ol class="mt-3 space-y-3">
                {trip.beats.map((beat) => (
                  <li>
                    <p class="font-mono text-[.7rem] tracking-[.14em] text-ink/64 uppercase">{beat.label}</p>
                    <p class="font-display text-[1.15rem]">{beat.title}</p>
                    {beat.text && <p class="text-ink/74">{beat.text}</p>}
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </noscript>

      {
        block.footnote && (
          <div class="mx-auto max-w-site px-pad py-10">
            <p class="max-w-[60ch] text-[.92rem] leading-[1.65] text-ink/64" data-tina-field={tinaField(block, "footnote")}>{block.footnote}</p>
          </div>
        )
      }
    </section>
  )
}
