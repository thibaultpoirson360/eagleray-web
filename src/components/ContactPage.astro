---
/**
 * `/<locale>/contact` — "Talk with us". Built from a wireframe, not source —
 * index.html/styles.css/main.js have no contact-page markup or form logic
 * at all (see tina/collections/contactPage.ts's comment for what was
 * actually grepped for). Extracted into its own component (rather than
 * inlined in src/pages/[locale]/contact.astro) for the same reason every
 * homepage section is: the on-demand island-refresh route
 * (src/pages/tina-island/[name].ts) needs a component reference to
 * re-render, matching Hero/Difference/etc.'s pattern exactly.
 */
import ContactForm from "./ContactForm.tsx";
import Button from "./ui/Button.astro";
import { tinaField } from "@tinacms/astro/tina-field";
import { localePath, type Locale } from "../i18n/config";
import type { ContactPageQuery, SiteSettingsQuery } from "../../tina/__generated__/types";

interface Props {
  contactPage: ContactPageQuery["contactPage"];
  siteSettings: SiteSettingsQuery["siteSettings"];
  locale: Locale;
}

const { contactPage, siteSettings, locale } = Astro.props;
const waHref = siteSettings.contact?.whatsapp ? `https://wa.me/${siteSettings.contact.whatsapp}` : undefined;
---

<section class="relative mx-auto max-w-site border-t border-ink/8 py-section pr-pad pl-[calc(var(--spacing-pad)+var(--rail))]">
  <div class="grid gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
    {
      contactPage.photo && (
        <img
          src={contactPage.photo}
          alt={contactPage.photoAlt ?? ""}
          loading="eager"
          decoding="async"
          class="aspect-[4/5] w-full rounded-lg object-cover"
          data-tina-field={tinaField(contactPage, "photo")}
        />
      )
    }

    <div>
      <h1 class="h2 text-h2 tracking-[.08em] uppercase" data-tina-field={tinaField(contactPage, "title")}>
        {contactPage.title}
      </h1>
      {
        contactPage.lede && (
          <p class="mt-4 max-w-[46ch] text-ink/74" data-tina-field={tinaField(contactPage, "lede")}>
            {contactPage.lede}
          </p>
        )
      }

      {
        contactPage.form && (
          <div class="mt-9">
            <ContactForm
              client:visible
              leadEndpoint={siteSettings.leadEndpoint ?? ""}
              copy={{
                namePlaceholder: contactPage.form.namePlaceholder,
                emailPlaceholder: contactPage.form.emailPlaceholder,
                howFoundPlaceholder: contactPage.form.howFoundPlaceholder,
                messagePlaceholder: contactPage.form.messagePlaceholder,
                submitLabel: contactPage.form.submitLabel,
                sendingLabel: contactPage.form.sendingLabel,
                successMessage: contactPage.form.successMessage ?? "",
                errorMessage: contactPage.form.errorMessage ?? "",
              }}
            />
          </div>
        )
      }

      <div class="mt-10 grid gap-6 sm:grid-cols-[auto_1fr] sm:gap-x-5">
        {
          contactPage.whatsappCard && waHref && (
            <div class="flex flex-col items-start gap-3 sm:col-span-2 sm:grid sm:grid-cols-subgrid sm:items-center sm:gap-y-0">
              <a
                href={waHref}
                target="_blank"
                rel="noopener"
                class="inline-flex w-full flex-none items-center justify-center gap-2.5 rounded border border-transparent bg-ink px-6 py-4 text-center text-sm font-medium whitespace-nowrap text-white transition duration-500 ease-soft hover:-translate-y-0.5 hover:bg-ink-hover"
                data-tina-field={tinaField(contactPage.whatsappCard, "label")}
              >
                <svg class="size-5 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.3-.15-1.263-.465-2.403-1.485-.888-.795-1.484-1.77-1.66-2.07-.174-.3-.019-.465.13-.615.136-.135.301-.345.451-.52.146-.181.194-.301.297-.496.1-.21.049-.375-.025-.524-.075-.15-.672-1.62-.922-2.206-.24-.584-.487-.51-.672-.51-.172-.015-.371-.015-.571-.015-.2 0-.523.074-.797.359-.273.3-1.045 1.02-1.045 2.475s1.07 2.865 1.219 3.075c.149.18 2.095 3.195 5.076 4.483.709.3 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.696.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                </svg>
                {contactPage.whatsappCard.label}
              </a>
              {
                contactPage.whatsappCard.description && (
                  <p class="text-sm text-ink/74" data-tina-field={tinaField(contactPage.whatsappCard, "description")}>
                    {contactPage.whatsappCard.description}
                  </p>
                )
              }
            </div>
          )
        }
        {
          contactPage.expeditionCard && (
            <div class="flex flex-col items-start gap-3 sm:col-span-2 sm:grid sm:grid-cols-subgrid sm:items-center sm:gap-y-0">
              <Button
                href={localePath(locale, "#customize")}
                variant="primary"
                context="default"
                class="w-full flex-none text-center"
                data-tina-field={tinaField(contactPage.expeditionCard, "label")}
              >
                {contactPage.expeditionCard.label}
              </Button>
              {
                contactPage.expeditionCard.description && (
                  <p class="text-sm text-ink/74" data-tina-field={tinaField(contactPage.expeditionCard, "description")}>
                    {contactPage.expeditionCard.description}
                  </p>
                )
              }
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
