---
/**
 * A row of photos under a section of a private proposal (a day, the
 * included services, a practical topic). One photo fills the row; two, three
 * or more sit side by side in a grid. Photos come from the editor; the alt
 * text is the description the editor wrote for each.
 */
import { tinaField } from "@tinacms/astro/tina-field";

interface Props {
  photos?: ({ image?: string | null; alt?: string | null } | null)[] | null;
  class?: string;
}

const { photos, class: extra } = Astro.props;
const list = (photos ?? []).filter((p): p is { image: string; alt?: string | null } => !!p?.image);
const cols = list.length === 1 ? "grid-cols-1" : list.length === 2 ? "grid-cols-2" : "grid-cols-2 md:grid-cols-3";
---

{
  list.length > 0 && (
    <div class:list={["grid gap-4 md:gap-6", cols, extra]}>
      {list.map((p) => (
        <figure class="m-0">
          <img src={p.image} alt={p.alt ?? ""} loading="lazy" decoding="async" class:list={["w-full rounded-lg object-cover", list.length === 1 ? "aspect-[21/9]" : "aspect-[4/3]"]} data-tina-field={tinaField(p, "image")} />
        </figure>
      ))}
    </div>
  )
}
