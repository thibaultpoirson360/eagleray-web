---
/**
 * A mosaic of photos under a section of a private proposal. Rows are always
 * full, with no empty cells: the photos are split into rows of up to three
 * and each photo stretches to share its row, so 5 photos are 3 on top and 2
 * below (the two below fill the same width as the three above), 4 are 2 + 2,
 * 7 are 3 + 2 + 2, and a single photo fills the whole width, long and
 * narrow. On a phone the rows are two photos wide, and an odd last photo
 * takes the whole row. The classes are written out in full so Tailwind
 * keeps them.
 */
import { tinaField } from "@tinacms/astro/tina-field";

interface Props {
  photos?: ({ image?: string | null; alt?: string | null; caption?: string | null } | null)[] | null;
  class?: string;
  /** Keep photo slots that have no photo yet as quiet empty boxes, so an editor can click one and add it. */
  slots?: boolean;
  /** A single photo keeps its own proportions (a map, for instance) instead of being cropped to a wide strip. */
  natural?: boolean;
  /** Portraits of people: taller photos, cropped from the top so faces are kept. */
  portrait?: boolean;
  /** A strip of equal photos, two per row on a phone and four on a laptop, for a collage of faces. */
  strip?: boolean;
}

const { photos, class: extra, slots = false, natural = false, portrait = false, strip = false } = Astro.props;
const list = (photos ?? []).filter((p): p is { image: string; alt?: string | null; caption?: string | null } => (slots ? !!p : !!p?.image));
const n = list.length;

// Sizes of the rows, biggest first: 4 -> 2+2, 5 -> 3+2, 7 -> 3+2+2, 8 -> 3+3+2.
const rowCount = Math.ceil(n / 3);
const base = Math.floor(n / rowCount);
const extraRows = n % rowCount;
const rows = Array.from({ length: rowCount }, (_, i) => base + (i < extraRows ? 1 : 0));
const perPhoto = rows.flatMap((size) => Array.from({ length: size }, () => size));

const wide = { 1: "md:col-span-6", 2: "md:col-span-3", 3: "md:col-span-2" } as const;
---

{
  n > 0 && strip && (
    <div class:list={["grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-6", extra]}>
      {list.map((p) => (
        <figure class="m-0">
          {p.image ? (
            <img src={p.image} alt={p.alt ?? ""} loading="lazy" decoding="async" class="aspect-[4/5] w-full rounded-lg object-cover object-[50%_20%]" data-tina-field={tinaField(p, "image")} />
          ) : (
            <div class="aspect-[4/5] w-full rounded-lg bg-current/10" data-tina-field={tinaField(p, "image")}></div>
          )}
          {p.caption && <figcaption class="mt-3 text-[.8rem] leading-snug opacity-70" data-tina-field={tinaField(p, "caption")}>{p.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )
}

{
  n > 0 && !strip && (
    <div class:list={["grid grid-cols-6 gap-3 md:gap-6", extra]}>
      {list.map((p, i) => (
        <figure class:list={["m-0", i === n - 1 && n % 2 === 1 ? "col-span-6" : "col-span-3", wide[perPhoto[i] as 1 | 2 | 3]]}>
          {p.image ? (
            <img
              src={p.image}
              alt={p.alt ?? ""}
              loading="lazy"
              decoding="async"
              class:list={["w-full rounded-lg", n === 1 && natural ? "h-auto" : "object-cover", portrait && "object-[50%_20%]", n === 1 ? (natural ? "" : "aspect-[16/9] md:aspect-[21/9]") : portrait ? "aspect-[4/5]" : "aspect-[4/3]"]}
              data-tina-field={tinaField(p, "image")}
            />
          ) : (
            <div class:list={["w-full rounded-lg bg-current/10", n === 1 ? "aspect-[16/9] md:aspect-[21/9]" : portrait ? "aspect-[4/5]" : "aspect-[4/3]"]} data-tina-field={tinaField(p, "image")}></div>
          )}
          {p.caption && <figcaption class="mt-3 text-[.8rem] leading-snug opacity-70" data-tina-field={tinaField(p, "caption")}>{p.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )
}
