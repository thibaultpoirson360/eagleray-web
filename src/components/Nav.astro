---
/**
 * Nav — `<nav class="nav">` + the mobile overlay `<div class="nav-mobile">`
 * in the source index.html (lines 44-84), CSS at styles.css "3. NAV"
 * (L437-717). Page chrome, not a homepage section — shown on every page,
 * so it lives in BaseLayout, not src/pages/[locale]/index.astro.
 *
 * The scroll-solidify color swap (.is-solid) and the mobile-menu open
 * state are both JS-toggled and can't be resolved once at Astro render
 * time — those live as real CSS in global.css (see the comment there),
 * referenced here via Tailwind's CSS-var arbitrary syntax
 * (text-(--nav-fg) etc.) so every nav-scoped color is one class toggle
 * instead of being duplicated per state. Neither initNav() (the scroll
 * listener + toggle click handler) nor initReveals()/initTilt()/
 * initMagnetic() run yet without src/scripts/chrome.ts wired into
 * BaseLayout — see that file and the layout diff in the same change.
 *
 * New schema (tina/collections/navigation.ts) — see that file's own
 * comment for why: not anticipated by the original 6-section schema
 * pass, added because CLAUDE.md's "every component must be editable"
 * rule applies to Nav too.
 *
 * Known, unresolved risk (audit §5, not something I can verify without
 * a real browser): 7 nav links at the lg (1024px) breakpoint may crowd
 * or wrap between ~1024-1150px. Flagging again now that it's built —
 * worth a visual check before launch.
 *
 * Language switcher (LangSwitch.tsx) is a deliberate departure from
 * source, which had a flat row of `.lang-btn` buttons (ES/FR commented
 * out) — a dropdown, per explicit direction. See that file's own comment.
 *
 * Nav dropdowns (About Us, Sail with Us today): source had no such
 * concept — every link was a plain href. New per explicit direction:
 * `tina/collections/navigation.ts`'s `links` field is now a template
 * union (plain "link" vs "dropdown" with its own sub-link list), and
 * items using the "dropdown" template render as NavDesktopDropdown.tsx /
 * NavMobileDropdown.tsx (Preact — open/close state, same category as
 * LangSwitch) instead of a plain `<a>`. Both are independent per
 * instance (no "close the other one" coordination) — see their own
 * comments.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import type { NavigationQuery } from "../../tina/__generated__/types";
import LangSwitch from "./LangSwitch.tsx";
import NavDesktopDropdown from "./NavDesktopDropdown.tsx";
import NavMobileDropdown from "./NavMobileDropdown.tsx";
import { locales, liveLocales, localePath, localeLabel, type Locale } from "../i18n/config";
import { homeAnchor } from "../lib/links";

interface Props {
  navigation: NavigationQuery["navigation"];
  locale: Locale;
  /** Path after the locale prefix, e.g. "" for the homepage — same shape BaseLayout uses. */
  path: string;
  /** See BaseLayout.astro's own prop comment — same meaning, passed straight through. */
  transparentNav: boolean;
}

const { navigation, locale, path, transparentNav } = Astro.props;
const { brand, links, cta } = navigation;

// Not Tina content — which locales exist and which have real pages is a
// routing fact (src/i18n/config.ts), same category as the scroll-solidify
// state or the mobile-menu toggle, not editorial copy. `localePath`
// (root-relative), not `localeHref` (absolute against astro.config's
// fixed `site` — right for BaseLayout's canonical/hreflang tags, wrong
// here since it would send local dev clicks to the real production
// domain instead of staying on localhost).
// The logo's own link: home in the current locale, not "#top" (which is
// only a valid anchor on the homepage itself — on every other page it's
// dead, since there's no id="top" element there).
const homeHref = localePath(locale, "");
const langOptions = locales.map((l) => ({
  locale: l,
  label: l.toUpperCase(),
  fullLabel: localeLabel[l],
  href: localePath(l, path),
  isLive: liveLocales.includes(l),
}));
---

<nav
  id="site-nav"
  class={`nav fixed inset-x-0 top-0 z-[100] flex h-nav items-center justify-between gap-6 pr-pad pl-[calc(var(--spacing-pad)+var(--rail))] transition-[background-color,backdrop-filter,box-shadow,height] duration-[450ms] ease-out ${transparentNav ? "" : "is-solid"}`}
  data-nav
  data-nav-transparent={transparentNav ? "true" : "false"}
  aria-label={navigation.ariaLabel ?? "Main"}
>
  <a class="nav-brand flex items-center gap-[.8rem] text-(--nav-fg)" href={homeHref}>
    {
      brand?.markLight && (
        <img
          class="nav-logo-light block h-11 w-auto flex-none [.is-solid_&]:hidden"
          src={brand.markLight}
          alt=""
          width="1030"
          height="646"
          data-tina-field={tinaField(brand, "markLight")}
        />
      )
    }
    {
      brand?.wordmarkLight && (
        <img
          class="nav-logo-light block h-[30px] w-auto flex-none [.is-solid_&]:hidden"
          src={brand.wordmarkLight}
          alt={brand.wordmarkAlt ?? ""}
          width="1064"
          height="351"
          data-tina-field={tinaField(brand, "wordmarkLight")}
        />
      )
    }
    {
      brand?.markDark && (
        <img
          class="nav-logo-ink hidden h-11 w-auto flex-none [.is-solid_&]:block"
          src={brand.markDark}
          alt=""
          width="1030"
          height="646"
          data-tina-field={tinaField(brand, "markDark")}
        />
      )
    }
    {
      brand?.wordmarkDark && (
        <img
          class="nav-logo-ink hidden h-[30px] w-auto flex-none [.is-solid_&]:block"
          src={brand.wordmarkDark}
          alt={brand.wordmarkAlt ?? ""}
          width="1064"
          height="351"
          data-tina-field={tinaField(brand, "wordmarkDark")}
        />
      )
    }
  </a>

  <LangSwitch client:visible current={locale} options={langOptions} label={navigation.languageLabel ?? undefined} />

  <button
    class="nav-toggle z-[101] ml-auto flex flex-col gap-[5px] p-2 lg:hidden"
    data-nav-toggle
    aria-expanded="false"
    aria-controls="nav-mobile"
    aria-label={navigation.toggleLabel ?? "Toggle menu"}
  >
    <span class="h-[1.5px] w-[22px] bg-(--nav-fg) transition-[translate,rotate,opacity,background-color] duration-300 ease-out" />
    <span class="h-[1.5px] w-[22px] bg-(--nav-fg) transition-[translate,rotate,opacity,background-color] duration-300 ease-out" />
    <span class="h-[1.5px] w-[22px] bg-(--nav-fg) transition-[translate,rotate,opacity,background-color] duration-300 ease-out" />
  </button>

  <div class="nav-links ml-auto hidden items-center gap-8 lg:flex">
    {
      links?.map((link, i) =>
        link?.__typename === "NavigationLinksDropdown" ? (
          <NavDesktopDropdown
            client:visible
            label={link.label}
            tinaField={tinaField(navigation, "links", i)}
            items={(link.items ?? [])
              .filter((it): it is NonNullable<typeof it> => !!it)
              .map((it, j) => ({ label: it.label, href: it.href, tinaField: tinaField(link, "items", j) }))}
          />
        ) : (
          link && (
            <a
              class="nav-link relative py-1 text-[.84rem] tracking-[.04em] text-(--nav-fg-mute) transition-colors duration-[400ms] ease-out after:absolute after:inset-x-0 after:bottom-[-3px] after:h-px after:origin-right after:scale-x-0 after:bg-current after:transition-transform after:duration-[450ms] after:ease-out after:content-[''] hover:text-(--nav-fg) hover:after:origin-left hover:after:scale-x-100"
              href={link.href}
              data-tina-field={tinaField(navigation, "links", i)}
            >
              {link.label}
            </a>
          )
        )
      )
    }
  </div>

  {
    cta && (
      <a
        class="nav-cta hidden rounded bg-ink px-[1.2rem] py-[.55rem] text-[.82rem] text-white transition-colors duration-300 ease-out hover:bg-ink-hover lg:inline-flex"
        href={homeAnchor(locale, cta.href)}
        data-tina-field={tinaField(navigation, "cta")}
      >
        {cta.label}
      </a>
    )
  }
</nav>

<div
  class="nav-mobile fixed inset-0 z-[99] flex flex-col justify-center gap-[1.4rem] bg-ink px-pad pt-24 pb-12 text-white [clip-path:inset(0_0_100%_0)] transition-[clip-path] duration-[650ms] ease-soft"
  id="nav-mobile"
  data-nav-mobile
  aria-hidden="true"
  inert
>
  {
    links?.map((link, i) =>
      link?.__typename === "NavigationLinksDropdown" ? (
        <NavMobileDropdown
          client:visible
          index={i}
          label={link.label}
          tinaField={tinaField(navigation, "links", i)}
          items={(link.items ?? [])
            .filter((it): it is NonNullable<typeof it> => !!it)
            .map((it, j) => ({ label: it.label, href: it.href, tinaField: tinaField(link, "items", j) }))}
        />
      ) : (
        link && (
          <a class="flex items-baseline gap-4 font-display text-nav-mobile italic" href={link.href}>
            <i class="font-mono text-[.62rem] tracking-widest text-white/60 not-italic">
              {String(i + 1).padStart(2, "0")}
            </i>
            <span>{link.label}</span>
          </a>
        )
      )
    )
  }
  {
    cta && (
      <a class="nav-cta mt-[.8rem] inline-flex rounded border border-white/35 px-[1.4rem] py-[.7rem] text-base text-white" href={homeAnchor(locale, cta.href)}>
        {cta.mobileLabel}
      </a>
    )
  }
  {navigation.mobileFoot && <p class="nav-mobile-foot mt-auto font-mono text-[.68rem] tracking-widest">{navigation.mobileFoot}</p>}
</div>
