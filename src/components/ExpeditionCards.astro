---
/**
 * The expedition cards on the Sail with Us page (Sail With Us.dc.html): a
 * photo with the name over it. Each card links to its expedition's page.
 * Plain links, so no JavaScript is needed (the slider's dots are the only script).
 */
import SliderDots from "./SliderDots.tsx";

export interface ExpeditionCard {
  id: string;
  name: string;
  image?: string;
  imageAlt?: string;
  href?: string;
  /** `data-tina-field` value, so the card can be clicked to edit. */
  field?: string;
  /** Short text under the card, and its `data-tina-field`. */
  description?: string;
  descriptionField?: string;
  /** Small badge on the photo (e.g. limited dates), a facts line and a price line under the text. */
  badge?: string;
  facts?: string;
  priceNote?: string;
}

interface Props {
  expeditions: ExpeditionCard[];
  linkLabel: string;
  /** One row that scrolls sideways (cards keep the same size as in the grid) instead of a grid. */
  slider?: boolean;
  /** Accessible name of the slider. */
  sliderLabel?: string;
}

const { expeditions, linkLabel, slider = false, sliderLabel } = Astro.props;
// Cards fill the row: 1 card full width, 2 cards split it, 4 cards go two by two
// (wider, all the same size), 3 or 5 or more use three columns.
const twoByTwo = !slider && expeditions.length === 4;
const columns =
  expeditions.length === 1 ? "grid-cols-1" : expeditions.length === 2 || twoByTwo ? "md:grid-cols-2" : "md:grid-cols-2 lg:grid-cols-3";
---

<div
  class:list={slider ? "-mx-1 -mt-2 flex snap-x snap-mandatory gap-8 overflow-x-auto px-1 pt-2 pb-6 [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" : `grid gap-8 ${columns}`}
  data-expeditions-slider={slider ? "" : undefined}
  tabindex={slider ? 0 : undefined}
  role={slider ? "group" : undefined}
  aria-label={slider ? sliderLabel : undefined}
>
  {
    expeditions.map((expedition) => (
      <div class:list={[slider && "expedition-card w-full shrink-0 snap-start sm:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-4rem)/3)]"]}>
        <a
          href={expedition.href || "#"}
          data-tina-field={expedition.field}
          class:list={["group relative block overflow-hidden rounded-lg bg-ink transition duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[0_18px_40px_rgb(14_27_43/0.14)]", twoByTwo ? "aspect-square lg:aspect-[4/3]" : "aspect-square"]}
        >
          {expedition.image && (
            <img src={expedition.image} alt={expedition.imageAlt ?? ""} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
          )}
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ink/60 via-ink/5 to-ink/55" />
          <p class="absolute top-4 left-4 right-4 font-display text-[1.15rem] text-white">{expedition.name}</p>
          {expedition.badge && (
            <span class="absolute right-4 bottom-[4.5rem] left-4 w-fit rounded-sm bg-ink px-[.7rem] py-[.35rem] font-mono text-[.6rem] tracking-[.1em] text-white uppercase">
              {expedition.badge}
            </span>
          )}
          <span class="absolute bottom-5 left-1/2 -translate-x-1/2 rounded-sm bg-white/90 px-6 py-2.5 text-[.82rem] tracking-[.04em] whitespace-nowrap text-ink transition-colors group-hover:bg-white">
            {linkLabel}
          </span>
        </a>
        {expedition.description && (
          <p class="mt-4 text-[.92rem] leading-[1.6] text-ink/74" data-tina-field={expedition.descriptionField}>
            {expedition.description}
          </p>
        )}
        {expedition.facts && <p class="mt-3 font-mono text-[.68rem] tracking-[.1em] text-ink/64 uppercase">{expedition.facts}</p>}
        {expedition.priceNote && <p class="mt-1 font-display text-[1.05rem] text-ink">{expedition.priceNote}</p>}
      </div>
    ))
  }
</div>
{slider && expeditions.length > 1 && <SliderDots client:visible sliderSelector="[data-expeditions-slider]" cardSelector=".expedition-card" count={expeditions.length} labelPrefix="Go to expedition" />}

