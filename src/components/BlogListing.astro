---
/**
 * `/en/blog` — "Journal" listing. Built from a design mockup (Wayfarer
 * Journal.dc.html, pasted directly since /design-login couldn't run in
 * this session), not source — same situation as the Contact page. See
 * tina/collections/blog.ts for the schema decisions (rich-text body,
 * explicit `featured` field).
 *
 * The mockup's own header/nav (logo + "Expeditions/Journal/Crew/Contact")
 * is just prototype chrome to show the page in context — this reuses the
 * real Nav/BaseLayout instead, same as every other page.
 *
 * Extracted into its own component (not inlined in the page) so the
 * on-demand island-refresh route can re-render it, matching every other
 * section's pattern.
 */
import Button from "./ui/Button.astro";
import { tinaField } from "@tinacms/astro/tina-field";
import { featuredPost } from "../lib/content";
import type { BlogSectionQuery, BlogPostConnectionQuery } from "../../tina/__generated__/types";

type Post = NonNullable<NonNullable<BlogPostConnectionQuery["blogPostConnection"]["edges"]>[number]>["node"];

interface Props {
  blogSection: BlogSectionQuery["blogSection"];
  posts: NonNullable<Post>[];
}

const { blogSection, posts } = Astro.props;
const featured = posts.length ? featuredPost(posts) : undefined;
const grid = posts.filter((p) => p !== featured);

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}

function postHref(post: NonNullable<Post>): string {
  return `/en/blog/${post._sys.filename}/`;
}
---

<section class="relative mx-auto max-w-site border-t border-ink/8 py-section pr-pad pl-[calc(var(--spacing-pad)+var(--rail))]">
  <p
    class="mb-5 flex items-center gap-[.6rem] font-mono text-[.76rem] tracking-[.14em] text-ink/52 uppercase"
    data-tina-field={tinaField(blogSection, "metaLine")}
  >
    <span class="size-1.5 flex-none rounded-full bg-ink animate-pulse-dot motion-reduce:animate-none" aria-hidden="true" />
    {blogSection.metaLine}
  </p>
  <h1 class="max-w-[820px] font-display text-[clamp(34px,5vw,54px)]" data-tina-field={tinaField(blogSection, "title")}>
    {blogSection.title}
  </h1>
  {
    blogSection.lede && (
      <p class="mt-[18px] max-w-[540px] text-ink/52" data-tina-field={tinaField(blogSection, "lede")}>
        {blogSection.lede}
      </p>
    )
  }

  {
    featured && (
      <div class="mt-16 grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:items-center">
        <a href={postHref(featured)} class="relative block aspect-video w-full overflow-hidden rounded-lg">
          {featured.coverImage && (
            <img
              src={featured.coverImage}
              alt={featured.coverImageAlt ?? ""}
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover"
              data-tina-field={tinaField(featured, "coverImage")}
            />
          )}
        </a>
        <div>
          <div class="mb-[14px] text-[.72rem] tracking-[.1em] text-ink/52 uppercase">
            Featured · <span data-tina-field={tinaField(featured, "category")}>{featured.category}</span>
          </div>
          <h2 class="mb-[14px] text-[32px]">
            <a href={postHref(featured)} data-tina-field={tinaField(featured, "title")}>
              {featured.title}
            </a>
          </h2>
          {
            featured.excerpt && (
              <p class="mb-5 text-ink/62" data-tina-field={tinaField(featured, "excerpt")}>
                {featured.excerpt}
              </p>
            )
          }
          <div class="mb-[18px] text-[13px] text-ink/52">
            {featured.author} · {formatDate(featured.date)} · {featured.readTime}
          </div>
          <Button href={postHref(featured)} variant="ghost" context="default">
            Read the story →
          </Button>
        </div>
      </div>
    )
  }

  {grid.length > 0 && <hr class="my-16 border-t border-ink/8" />}

  <div class="grid gap-x-8 gap-y-11 [grid-template-columns:repeat(auto-fill,minmax(280px,1fr))]">
    {
      grid.map((post) => (
        <a href={postHref(post)} class="block">
          <div class="relative aspect-[4/3] overflow-hidden rounded-lg">
            {post.coverImage && (
              <img
                src={post.coverImage}
                alt={post.coverImageAlt ?? ""}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
                data-tina-field={tinaField(post, "coverImage")}
              />
            )}
          </div>
          <div class="mt-4 text-xs text-ink/52">
            {post.author} · {formatDate(post.date)}
          </div>
          <h3 class="mt-2 mb-2 text-xl" data-tina-field={tinaField(post, "title")}>
            {post.title}
          </h3>
          {post.excerpt && (
            <p class="text-sm text-ink/55" data-tina-field={tinaField(post, "excerpt")}>
              {post.excerpt}
            </p>
          )}
        </a>
      ))
    }
  </div>
</section>
