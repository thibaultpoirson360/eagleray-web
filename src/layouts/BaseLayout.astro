---
import '../styles/global.css';
import { defaultLocale, liveLocales, localeHref, ogLocale, type Locale } from '../i18n/config';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Sounder from '../components/Sounder.astro';
import { loadNavigation, loadFooter, loadSiteSettings } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Path after the locale prefix, e.g. "" for the homepage or "about-us/". */
  path?: string;
  /**
   * True (default) for a page whose top section is a dark hero the nav can
   * float transparently over until scrolled (today: the homepage). False
   * for a page with no such hero — a plain white section right at the top
   * — where the nav must render solid (dark-on-light) from the very first
   * paint instead of waiting for scroll, or its white-on-transparent
   * default state is unreadable against the page's own white background.
   */
  transparentNav?: boolean;
}

const { title, description, locale = defaultLocale, path = '', transparentNav = true } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const urlFor = (l: Locale) => localeHref(l, path, site);

// Page chrome, not page content — fetched here (not per-page) so every
// page that uses this layout gets Nav/Footer for free.
const navigationResult = await loadNavigation(locale);
const [footerResult, siteSettingsResult] = await Promise.all([loadFooter(locale), loadSiteSettings()]);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={urlFor(locale)} />
    {liveLocales.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)}
    <link rel="alternate" hreflang="x-default" href={urlFor(defaultLocale)} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {liveLocales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <!--
      Source index.html <head>: `document.documentElement.className += " js"`.
      Synchronous and inline so it runs before first paint — every
      `html.js` / `html:not(.js)` progressive-enhancement rule (reveal's
      no-JS fallback being the first one built) depends on this marker
      existing before CSS paints, not after.
    -->
    <script is:inline>document.documentElement.className += ' js';</script>
  </head>
  <body class="bg-white font-sans text-ink">
    <!--
      Not wrapped in a <TinaIsland>: unlike Nav/Footer this isn't really
      content (no copy of its own, no data-tina-field markers) — it's a
      technical readout of siteSettings.sounder.maxDepth and the
      navigation's per-locale surfaceLabel — both editable in the Tina
      admin (Site Settings / Navigation), just not click-to-edit on the
      gauge itself.
    -->
    <Sounder siteSettings={siteSettingsResult.data.siteSettings} surfaceLabel={navigationResult.data.navigation.surfaceLabel} />
    <TinaIsland
      name="navigation"
      wrapper={{ tag: 'div' }}
      params={{ locale, path, transparentNav: String(transparentNav) }}
    >
      <Nav navigation={navigationResult.data.navigation} locale={locale} path={path} transparentNav={transparentNav} />
    </TinaIsland>
    <slot />
    <TinaIsland name="footer" wrapper={{ tag: 'div' }} params={{ locale }}>
      <Footer footer={footerResult.data.footer} siteSettings={siteSettingsResult.data.siteSettings} />
    </TinaIsland>
    <script>
      import '../scripts/chrome.ts';
    </script>
  </body>
</html>
