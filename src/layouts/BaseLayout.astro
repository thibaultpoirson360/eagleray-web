---
import '../styles/global.css';
import { defaultLocale, liveLocales, ogLocale, type Locale } from '../i18n/config';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Path after the locale prefix, e.g. "" for the homepage or "about-us/". */
  path?: string;
}

const { title, description, locale = defaultLocale, path = '' } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const urlFor = (l: Locale) => new URL(`/${l}/${path}`, site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={urlFor(locale)} />
    {liveLocales.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)}
    <link rel="alternate" hreflang="x-default" href={urlFor(defaultLocale)} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {liveLocales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
  </head>
  <body class="bg-white font-sans text-ink">
    <slot />
  </body>
</html>
