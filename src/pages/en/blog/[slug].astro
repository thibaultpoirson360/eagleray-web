---
/**
 * `/en/blog/<slug>` — one Journal post. Thin wrapper, matching every other
 * page's pattern. Static output (astro.config.mjs), so every post's route
 * is enumerated at build time via getStaticPaths — same requirement any
 * Astro static site has for a dynamic list of content documents.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import BlogPostView from "../../../components/BlogPostView.astro";
import { loadBlogPost, loadBlogPosts } from "../../../lib/content";

export async function getStaticPaths() {
  const { posts } = await loadBlogPosts("en");
  return posts.map((post) => ({ params: { slug: post._sys.filename } }));
}

const { slug } = Astro.params;
const [postResult, allPostsResult] = await Promise.all([loadBlogPost("en", slug), loadBlogPosts("en")]);
const post = postResult.data.blogPost;
const related = allPostsResult.posts.filter((p) => p._sys.filename !== slug).slice(0, 2);
---

<BaseLayout title={`${post.title} — Eagle Ray Expeditions Journal`} locale="en" path={`blog/${slug}/`} transparentNav={false}>
  <main id="main">
    <TinaIsland name="blogPost" wrapper={{ tag: "div" }} params={{ locale: "en", slug }}>
      <BlogPostView post={post} related={related} />
    </TinaIsland>
  </main>
</BaseLayout>
