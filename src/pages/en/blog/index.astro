---
/**
 * `/en/blog` — Journal listing. Thin wrapper, matching every other page's
 * pattern: load data, wrap the real component in a <TinaIsland>. See
 * BlogListing.astro for the actual content.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import BlogListing from "../../../components/BlogListing.astro";
import { loadBlogSection, loadBlogPosts } from "../../../lib/content";

const [blogSectionResult, blogPostsResult] = await Promise.all([loadBlogSection("en"), loadBlogPosts("en")]);
---

<BaseLayout title={`${blogSectionResult.data.blogSection.title} — Eagle Ray Expeditions`} locale="en" path="blog/" transparentNav={false}>
  <main id="main">
    <TinaIsland name="blogSection" wrapper={{ tag: "div" }} params={{ locale: "en" }}>
      <BlogListing blogSection={blogSectionResult.data.blogSection} posts={blogPostsResult.posts} />
    </TinaIsland>
  </main>
</BaseLayout>
