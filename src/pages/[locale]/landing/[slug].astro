---
/**
 * `/<locale>/landing/<slug>/` — one landing page, enumerated at build time
 * (output: 'static', astro.config.mjs) via getStaticPaths, the same
 * pattern as /<locale>/blog/[slug].astro. See tina/collections/landingPage.ts's
 * header comment for why this URL lives under its own /landing/ namespace
 * rather than directly under /<locale>/.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import LandingPageView from "../../../components/LandingPageView.astro";
import { loadLandingPage, loadLandingPages } from "../../../lib/content";

import { liveLocales, type Locale } from "../../../i18n/config";

export async function getStaticPaths() {
  const perLocale = await Promise.all(
    liveLocales.map(async (locale) => {
      const { pages } = await loadLandingPages(locale);
      return pages.map((page) => ({ params: { locale, slug: page._sys.filename } }));
    })
  );
  return perLocale.flat();
}

const { slug } = Astro.params;
const locale = Astro.params.locale as Locale;
const result = await loadLandingPage(locale, slug);
const landingPage = result.data.landingPage;
---

<BaseLayout
  title={`${landingPage.title} — Eagle Ray Expeditions`}
  locale={locale}
  path={`landing/${slug}/`}
  transparentNav={false}
>
  <main id="main">
    <TinaIsland name="landingPage" wrapper={{ tag: "div" }} params={{ locale, slug }}>
      <LandingPageView landingPage={landingPage} />
    </TinaIsland>
  </main>
</BaseLayout>
