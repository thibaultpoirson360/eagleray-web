---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Hero from "../../components/Hero.astro";
import Difference from "../../components/Difference.astro";
import Crew from "../../components/Crew.astro";
import Wildlife from "../../components/Wildlife.astro";
import Boats from "../../components/Boats.astro";
import Funnel from "../../components/Funnel.astro";
import {
  loadHero,
  loadDifference,
  loadCrewSection,
  loadCrew,
  loadWildlife,
  loadBoatsSection,
  loadBoats,
  loadFunnel,
  loadSiteSettings,
} from "../../lib/content";
import { liveLocales, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return liveLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

const heroResult = await loadHero(locale, { priority: "primary" });
const seo = heroResult.data.hero.seo;
const differenceResult = await loadDifference(locale);
const [crewSectionResult, crewResult] = await Promise.all([loadCrewSection(locale), loadCrew(locale)]);
const wildlifeResult = await loadWildlife(locale);
const [boatsSectionResult, boatsResult] = await Promise.all([loadBoatsSection(locale), loadBoats(locale)]);
const [funnelResult, siteSettingsResult] = await Promise.all([loadFunnel(locale), loadSiteSettings()]);
---

<BaseLayout
  title={seo?.title ?? "Eagle Ray Expeditions"}
  description={seo?.description ?? undefined}
  ogTitle={seo?.ogTitle ?? undefined}
  ogDescription={seo?.ogDescription ?? undefined}
  preloadImage={heroResult.data.hero.background?.image ?? undefined}
  locale={locale}
>
  <main id="main">
    <!--
      Neutral <div> wrapper for the bridge's DOM-patching target, not
      <section class="hero"> itself — TinaIsland's wrapper prop only
      supports {tag, className}, no id, and the real section needs
      id="top" for the nav's #top anchor. Hero.astro renders that
      section; this wrapper must match the island route's `wrapper`
      config exactly (src/pages/tina-island/[name].ts).
    -->
    <TinaIsland name="hero" wrapper={{ tag: "div" }} params={{ locale }} primary>
      <Hero hero={heroResult.data.hero} />
    </TinaIsland>
    <TinaIsland name="difference" wrapper={{ tag: "div" }} params={{ locale }}>
      <Difference difference={differenceResult.data.difference} />
    </TinaIsland>
    <TinaIsland name="crew" wrapper={{ tag: "div" }} params={{ locale }}>
      <Crew crewSection={crewSectionResult.data.crewSection} members={crewResult.members} locale={locale} />
    </TinaIsland>
    <TinaIsland name="wildlife" wrapper={{ tag: "div" }} params={{ locale }}>
      <Wildlife wildlife={wildlifeResult.data.wildlife} />
    </TinaIsland>
    <TinaIsland name="boats" wrapper={{ tag: "div" }} params={{ locale }}>
      <Boats boatsSection={boatsSectionResult.data.boatsSection} boats={boatsResult.boats} />
    </TinaIsland>
    <TinaIsland name="funnel" wrapper={{ tag: "div" }} params={{ locale }}>
      <Funnel funnel={funnelResult.data.funnel} siteSettings={siteSettingsResult.data.siteSettings} />
    </TinaIsland>
  </main>
</BaseLayout>
