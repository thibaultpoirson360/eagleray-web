---
/**
 * `/<locale>/recalibration-expedition/` — the Recalibration Expedition page,
 * from the Claude Design mockup (Recalibration Expedition.dc.html). Content is
 * content/recalibrationPage/en.json. Spanish and French fall back to the
 * title-only placeholder from navPages until their drafts exist (same as La Paz).
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TinaMarkdown from "@tinacms/astro/TinaMarkdown.astro";
import MoguProposal from "../../../components/MoguProposal.astro";
import BodyParagraph from "../../../components/richtext/BodyParagraph.astro";
import { loadNavPage, loadRecalibrationPage } from "../../../lib/content";
import { liveLocales, type Locale } from "../../../i18n/config";

export function getStaticPaths() {
  return liveLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const isEnglish = locale === "en";
const page = isEnglish ? (await loadRecalibrationPage("en")).data.recalibrationPage : null;
const placeholder = isEnglish ? null : (await loadNavPage(locale, "recalibration-expedition")).data.navPages;

const intro = page?.intro?.split(/\n\s*\n|\n/).filter(Boolean) ?? [];
const title = page ? (page.seo?.title ?? `${page.title} — Eagle Ray Expeditions`) : `${placeholder?.title ?? "Recalibration Expedition"} — Eagle Ray Expeditions`;
---

<BaseLayout
  title={title}
  description={page?.seo?.description ?? undefined}
  locale={locale}
  path="recalibration-expedition/"
  transparentNav={false}
  noindex={!isEnglish}
>
  <main id="main">
    {
      page ? (
        <>
          <section class="relative aspect-[16/9] max-h-[68vh] w-full overflow-hidden bg-surface">
            {page.heroImage && <img src={page.heroImage} alt={page.heroImageAlt ?? ""} class="absolute inset-0 h-full w-full object-cover" />}
            <div class="absolute inset-x-0 top-0 flex flex-col items-center gap-3 px-5 pt-[clamp(28px,6vw,56px)] text-center">
              <h1 class="text-[clamp(1.625rem,4.2vw,2.5rem)] tracking-[.06em] text-[#16263a] uppercase">{page.title}</h1>
              {page.subtitle && <p class="text-[.9375rem] text-[#16263a]/80">{page.subtitle}</p>}
            </div>
          </section>

          <section class="mx-auto grid max-w-[1100px] items-center gap-12 px-5 py-20 md:grid-cols-2 lg:pr-pad lg:pl-[calc(var(--spacing-pad)+var(--rail))]">
            <div class="text-[1.05rem] leading-[1.75] text-ink/75">
              {intro.map((paragraph) => (
                <p class="mb-4 last:mb-0">{paragraph}</p>
              ))}
            </div>
            {page.introImage && (
              <div class="relative aspect-[4/3] overflow-hidden rounded-md bg-surface">
                <img src={page.introImage} alt={page.introImageAlt ?? ""} loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
            )}
          </section>

          {page.moguTripSlug && (
            <section class="mx-auto max-w-[1100px] px-5 pb-20 lg:pr-pad lg:pl-[calc(var(--spacing-pad)+var(--rail))]">
              {page.durationLabel && (
                <p class="mb-10 text-center font-mono text-[.76rem] tracking-[.24em] text-ink/50 uppercase">{page.durationLabel}</p>
              )}
              <div class="overflow-hidden rounded border border-ink/26">
                <MoguProposal tripSlug={page.moguTripSlug} height={640} title={page.title} />
              </div>
            </section>
          )}

          <section class="mx-auto max-w-[1200px] border-t border-ink/14 px-5 pt-14 lg:pr-pad lg:pl-[calc(var(--spacing-pad)+var(--rail))]">
            {page.aboardLabel && (
              <p class="mb-12 text-center font-mono text-[.76rem] tracking-[.24em] text-ink/50 uppercase">{page.aboardLabel}</p>
            )}
          </section>

          <section class="mx-auto grid max-w-[1100px] items-start gap-12 px-5 pb-16 md:grid-cols-2 lg:pr-pad lg:pl-[calc(var(--spacing-pad)+var(--rail))]">
            <div>
              {page.onBoardLabel && <p class="mb-6 font-mono text-[.7rem] tracking-[.14em] text-ink/64 uppercase">{page.onBoardLabel}</p>}
              <div class="text-[.92rem] text-ink/68">
                <TinaMarkdown content={page.onBoard} components={{ p: BodyParagraph }} />
              </div>
            </div>
            {page.onBoardImage && (
              <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-surface">
                <img src={page.onBoardImage} alt={page.onBoardImageAlt ?? ""} loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
            )}
          </section>

          <section class="mx-auto grid max-w-[1100px] items-start gap-12 px-5 pb-20 md:grid-cols-2 lg:pr-pad lg:pl-[calc(var(--spacing-pad)+var(--rail))]">
            {page.notOnBoardImage && (
              <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-surface">
                <img src={page.notOnBoardImage} alt={page.notOnBoardImageAlt ?? ""} loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
            )}
            <div>
              {page.notOnBoardLabel && <p class="mb-6 font-mono text-[.7rem] tracking-[.14em] text-ink/64 uppercase">{page.notOnBoardLabel}</p>}
              <div class="text-[.92rem] text-ink/60">
                <TinaMarkdown content={page.notOnBoard} components={{ p: BodyParagraph }} />
              </div>
            </div>
          </section>

          {page.cta && (
            <section class="pb-24 text-center">
              <a
                href={page.cta.href}
                class="inline-flex items-center rounded bg-ink px-7 py-4 text-[.92rem] text-white transition-colors hover:bg-ink-hover"
              >
                {page.cta.label}
              </a>
            </section>
          )}
        </>
      ) : (
        <section class="relative mx-auto max-w-site py-section pr-pad pl-[calc(var(--spacing-pad)+var(--rail))]">
          <h1 class="text-h2">{placeholder?.title}</h1>
        </section>
      )
    }
  </main>
</BaseLayout>
