---
/**
 * `/<locale>/blog` — Journal listing. Thin wrapper, matching every other page's
 * pattern: load data, wrap the real component in a <TinaIsland>. See
 * BlogListing.astro for the actual content.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import BlogListing from "../../../components/BlogListing.astro";
import { loadBlogSection, loadBlogPosts } from "../../../lib/content";
import { liveLocales, type Locale } from "../../../i18n/config";

export function getStaticPaths() {
  return liveLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

const [blogSectionResult, blogPostsResult] = await Promise.all([loadBlogSection(locale), loadBlogPosts(locale)]);
---

<BaseLayout title={`${blogSectionResult.data.blogSection.title} — Eagle Ray Expeditions`} locale={locale} path="blog/" transparentNav={false}>
  <main id="main">
    <TinaIsland name="blogSection" wrapper={{ tag: "div" }} params={{ locale }}>
      <BlogListing blogSection={blogSectionResult.data.blogSection} posts={blogPostsResult.posts} locale={locale} />
    </TinaIsland>
  </main>
</BaseLayout>
