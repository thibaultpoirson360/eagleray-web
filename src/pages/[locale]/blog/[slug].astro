---
/**
 * `/<locale>/blog/<slug>` — one Journal post. Thin wrapper, matching every other
 * page's pattern. Static output (astro.config.mjs), so every post's route
 * is enumerated at build time via getStaticPaths — same requirement any
 * Astro static site has for a dynamic list of content documents.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import BlogPostView from "../../../components/BlogPostView.astro";
import { loadBlogSection, loadBlogPost, loadBlogPosts } from "../../../lib/content";
import { liveLocales, type Locale } from "../../../i18n/config";

export async function getStaticPaths() {
  const perLocale = await Promise.all(
    liveLocales.map(async (locale) => {
      const { posts } = await loadBlogPosts(locale);
      return posts.map((post) => ({ params: { locale, slug: post._sys.filename } }));
    })
  );
  return perLocale.flat();
}

const { slug } = Astro.params;
const locale = Astro.params.locale as Locale;
const [postResult, allPostsResult, blogSectionResult] = await Promise.all([
  loadBlogPost(locale, slug),
  loadBlogPosts(locale),
  loadBlogSection(locale),
]);
const post = postResult.data.blogPost;
const related = allPostsResult.posts.filter((p) => p._sys.filename !== slug).slice(0, 2);
---

<BaseLayout
  title={`${post.title} — Eagle Ray Expeditions`}
  description={post.excerpt ?? post.subtitle ?? undefined}
  ogImage={post.coverImage ?? undefined}
  locale={locale}
  path={`blog/${slug}/`}
  transparentNav={false}
>
  <main id="main">
    <TinaIsland name="blogPost" wrapper={{ tag: "div" }} params={{ locale, slug }}>
      <BlogPostView post={post} related={related} blogSection={blogSectionResult.data.blogSection} locale={locale} />
    </TinaIsland>
  </main>
</BaseLayout>
