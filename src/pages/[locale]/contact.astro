---
/**
 * `/<locale>/contact` — "Talk with us". Thin page wrapper, matching
 * src/pages/[locale]/index.astro's own pattern: load data, wrap the real
 * component in a <TinaIsland> for visual editing. See ContactPage.astro
 * for why the content lives in its own component instead of being
 * inlined here.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import ContactPage from "../../components/ContactPage.astro";
import { loadContactPage, loadSiteSettings } from "../../lib/content";
import { liveLocales, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return liveLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

const [contactPageResult, siteSettingsResult] = await Promise.all([
  loadContactPage(locale),
  loadSiteSettings(),
]);
---

<BaseLayout
  title={contactPageResult.data.contactPage.seo?.title ?? `${contactPageResult.data.contactPage.title} — Eagle Ray Expeditions`}
  description={contactPageResult.data.contactPage.seo?.description ?? contactPageResult.data.contactPage.lede ?? undefined}
  ogTitle={contactPageResult.data.contactPage.seo?.ogTitle ?? undefined}
  ogDescription={contactPageResult.data.contactPage.seo?.ogDescription ?? undefined}
  locale={locale}
  path="contact/"
  transparentNav={false}
>
  <main id="main">
    <TinaIsland name="contactPage" wrapper={{ tag: "div" }} params={{ locale }}>
      <ContactPage
        contactPage={contactPageResult.data.contactPage}
        siteSettings={siteSettingsResult.data.siteSettings}
        locale={locale}
      />
    </TinaIsland>
  </main>
</BaseLayout>
