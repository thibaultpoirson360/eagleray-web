---
/**
 * `/<locale>/about-us/` — the Our story page, from the Claude Design mockup.
 *
 * Each live language gets the full page once its aboutPage document exists
 * (content/aboutPage/<locale>.json; the translation workflow drafts es and fr
 * from the English file). Until then, the language shows the English page,
 * kept out of search engines.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AboutPageView from "../../../components/AboutPageView.astro";
import { loadAboutPages, localizeHrefs } from "../../../lib/content";
import { liveLocales, type Locale } from "../../../i18n/config";

export async function getStaticPaths() {
  return liveLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const own = (await loadAboutPages(locale)).pages[0];
const fallback = !own;
const aboutPage = own ?? (await loadAboutPages("en")).pages[0];
if (fallback) localizeHrefs(aboutPage, locale);
const title = aboutPage.seo?.title ?? `${aboutPage.title} — Eagle Ray Expeditions`;
---

<BaseLayout
  title={title}
  description={aboutPage.seo?.description ?? aboutPage.lede ?? undefined}
  ogTitle={aboutPage.seo?.ogTitle ?? undefined}
  ogDescription={aboutPage.seo?.ogDescription ?? undefined}
  locale={locale}
  path="about-us/"
  transparentNav
  noindex={fallback}
>
  <main id="main">
    <AboutPageView aboutPage={aboutPage} />
  </main>
</BaseLayout>
