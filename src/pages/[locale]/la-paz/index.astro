---
/**
 * `/<locale>/la-paz/` — the La Paz page, from the Claude Design mockup.
 *
 * Each language shows its own content/laPage/<locale>.json; a language
 * without one shows the English page (kept out of search engines).
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LaPageView from "../../../components/LaPageView.astro";
import { loadLaPage, loadPageOrEnglish } from "../../../lib/content";
import { liveLocales, type Locale } from "../../../i18n/config";

export function getStaticPaths() {
  return liveLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const { result, fallback } = await loadPageOrEnglish(locale, loadLaPage);
const laPage = result.data.laPage;

const title = laPage.seo?.title ?? `${laPage.title} — Eagle Ray Expeditions`;
const description = laPage.seo?.description ?? laPage.lede ?? undefined;
const ogTitle = laPage.seo?.ogTitle ?? undefined;
const ogDescription = laPage.seo?.ogDescription ?? undefined;
---

<BaseLayout
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  locale={locale}
  path="la-paz/"
  transparentNav
  noindex={fallback}
>
  <main id="main">
    <LaPageView laPage={laPage} />
  </main>
</BaseLayout>
