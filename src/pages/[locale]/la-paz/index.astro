---
/**
 * `/<locale>/la-paz/` — the La Paz page, from the Claude Design mockup.
 *
 * Each language gets the full page once its laPage document exists
 * (content/laPage/<locale>.json); until then it falls back to the title-only
 * placeholder from navPages.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LaPageView from "../../../components/LaPageView.astro";
import { loadLaPage, loadNavPage } from "../../../lib/content";
import { liveLocales, type Locale } from "../../../i18n/config";

export function getStaticPaths() {
  return liveLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const laPage = await loadLaPage(locale).then((r) => r.data.laPage).catch(() => null);
const placeholder = laPage ? null : (await loadNavPage(locale, "la-paz")).data.navPages;

const title = laPage
  ? (laPage.seo?.title ?? `${laPage.title} — Eagle Ray Expeditions`)
  : `${placeholder?.title ?? "La Paz"} — Eagle Ray Expeditions`;
const description = laPage?.seo?.description ?? laPage?.lede ?? undefined;
const ogTitle = laPage?.seo?.ogTitle ?? undefined;
const ogDescription = laPage?.seo?.ogDescription ?? undefined;
---

<BaseLayout
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  locale={locale}
  path="la-paz/"
  transparentNav={!!laPage}
  noindex={!laPage}
>
  <main id="main">
    {
      laPage ? (
        <LaPageView laPage={laPage} />
      ) : (
        <section class="relative mx-auto max-w-site py-section pr-pad pl-[calc(var(--spacing-pad)+var(--rail))]">
          <h1 class="text-h2">{placeholder?.title}</h1>
        </section>
      )
    }
  </main>
</BaseLayout>
